class BlendshapeTrait:
    """
    Trait bound to any node with ``MFn.kBlendShape``. Exposes the
    blendshape's geometry, scene-side target meshes, alias attributes,
    and a utility (:meth:`unpack`) to extract deformed result meshes
    for any targets that don't currently have an explicit source mesh
    connected. Also provides target management (add / remove / rename /
    in-betweens) addressed by name or index, target weights, and the
    blendshape-specific paintable base and per-target weights.
    """
    def geometry(self) -> mref.ReferencedItem | None:
        """
        Returns the transform that owns the first geometry this
        blendshape deforms, or None if no geometry is connected.
        """
    def scene_targets(self) -> mref.ReferenceList:
        """
        Returns the transforms of every mesh in the scene that's
        connected as a source for one of this blendshape's targets.
        Walks the
        ``inputTarget[*].inputTargetGroup[*].inputTargetItem[*].inputGeomTarget``
        plug tree and collects any upstream meshes.

        Only mesh shapes (``MFn.kMesh``) are returned — NURBS surface
        targets, if any, are not included.
        """
    def unpack(self) -> list:
        """
        Extracts a deformed result mesh for every target that doesn't
        currently have an explicit source mesh connected. Each
        extracted mesh is created by activating its target's weight
        in isolation, duplicating the base geometry to bake the
        result, and reconnecting that duplicate as the target's
        input mesh.

        Targets that already have a source mesh connected are
        skipped — only the "missing source" cases are extracted.

        Original blendshape weights are restored after extraction,
        even if an error occurs partway through (via try/finally).

        :return: List of names of the newly created mesh transforms.
        :raises RuntimeError: If the blendshape has no base geometry
            connected.
        """
    def disconnect_driving_inputs(self) -> None:
        """
        Disconnects every external connection driving this
        blendshape's weight aliases. Used by :meth:`unpack` to
        isolate each target before extraction; safe to call
        standalone if you want to freeze the blendshape in its
        current driven state.

        Uses MEL's ``CBdeleteConnection`` because that's the only
        idiom that properly tears down breakdown-style connections
        (anim curves, set driven keys, animation layers, plain
        connections) without leaving residue.

        ``CBdeleteConnection`` lives in ``channelBoxCommand.mel`` and
        isn't auto-sourced until the user first interacts with Maya's
        channel box, so we source it defensively up-front. MEL's
        ``source`` is idempotent, and we swallow load errors so this
        works in environments where the file doesn't exist (e.g.
        headless installs); if the proc still isn't available
        afterwards the subsequent ``CBdeleteConnection`` call will
        fail loudly, which is the right behaviour.
        """
    def alias_attributes(self) -> mref.ReferenceList:
        """
        Returns a ReferenceList of the blendshape's aliased weight
        attributes — one entry per target, addressed by its alias
        name rather than ``weight[i]``.
        """
    def weight_mapping(self) -> dict:
        """
        Returns a dict mapping each target's alias name to its
        underlying weight plug, e.g.::

            {"smile": "weight[0]", "frown": "weight[1]", ...}
        """
    def target_indices(self) -> list[int]:
        """
        Returns the (sparse) logical weight indices of every target, in
        ascending order.
        """
    def target_names(self) -> list[str]:
        """
        Returns the name (weight alias) of every target in index order.
        A target with no alias is reported as ``"weight[i]"``.
        """
    def target_index(self, name: str) -> int:
        """
        Returns the weight index of the target with the given name.

        :raises ValueError: If no target has that name.
        """
    def target_weight(self, target: str | int) -> float:
        """
        Returns the current weight of a target, given by name or index.
        """
    def set_target_weight(self, target: str | int, value: float) -> None:
        """
        Sets the weight of a target, given by name or index.
        """
    def zero_weights(self) -> None:
        """
        Sets every target weight to zero. Weights that are driven by a
        connection or locked are left untouched.
        """
    def add_target(self, mesh: mref.ReferencedItem | str, name: str=..., index: int=...) -> int:
        """
        Adds the given mesh as a new target, at the next free index
        unless ``index`` is given, and returns that index. The target is
        named after the mesh unless ``name`` is given.
        """
    def remove_target(self, target: str | int) -> None:
        """
        Removes a target (given by name or index) entirely, including its
        weight, alias, in-betweens and paintable weights. Works whether or
        not a source mesh is still connected.
        """
    def rename_target(self, target: str | int, new_name: str) -> None:
        """
        Renames a target (given by name or index) by re-aliasing its
        weight plug.
        """
    def add_in_between(self, target: str | int, mesh: mref.ReferencedItem | str, weight: float) -> None:
        """
        Adds the given mesh as an in-between of a target (given by name
        or index), triggered at the given weight (e.g. ``0.5``).
        """
    def in_between_weights(self, target: str | int) -> list[float]:
        """
        Returns the weights at which a target's in-betweens trigger,
        sorted ascending. The full target (weight ``1.0``) is excluded.
        """
    def base_weights(self, shape: mref.ReferencedItem | str=...) -> list[float]:
        """
        Returns the per-component base weights painted on the
        blendshape for the given shape (default: first output shape).

        Where Maya stores these changed between versions — up to 2024
        they live in ``inputTarget[n].baseWeights``, from 2025 in the
        generic ``weightList`` (``baseWeights`` is then ignored). This
        is an alias of ``GeometryFilter.deformer_weights``, which reads
        whichever one drives the deformation.
        """
    def set_base_weights(self, weights: list[float], shape: mref.ReferencedItem | str=...) -> None:
        """
        Sets the per-component base weights for the given shape (default:
        first output shape). ``weights`` must have one entry per component.
        See :meth:`base_weights` for where they are stored.
        """
    def target_component_weights(self, target: str | int, shape: mref.ReferencedItem | str=...) -> list[float]:
        """
        Returns the per-component paintable weights of a single target
        (``inputTargetGroup[i].targetWeights``) for the given shape
        (default: first output shape).
        """
    def set_target_component_weights(self, target: str | int, weights: list[float], shape: mref.ReferencedItem | str=...) -> None:
        """
        Sets the per-component paintable weights of a single target for
        the given shape (default: first output shape). ``weights`` must
        have one entry per component.
        """

class CameraTrait:
    """
    Trait bound to any node with ``MFn.kCamera`` — camera shape nodes.
    Exposes the lens (focal length, film aperture, field of view), the
    clipping planes, orthographic state and the world-space view vectors
    (eye point, view direction, up direction), plus an aim helper.

    Film aperture values are in inches (Maya's native unit for
    ``horizontalFilmAperture``/``verticalFilmAperture``), focal length in
    millimetres, field of view in degrees and distances in scene units.
    """
    def focal_length(self) -> float:
        """
        Returns the focal length of the camera in millimetres
        """
    def set_focal_length(self, value: float) -> None:
        """
        Sets the focal length of the camera in millimetres
        """
    def film_aperture(self) -> list[float]:
        """
        Returns the ``[horizontal, vertical]`` film aperture in inches
        """
    def set_film_aperture(self, horizontal: float, vertical: float) -> None:
        """
        Sets the horizontal and vertical film aperture in inches
        """
    def clip_planes(self) -> list[float]:
        """
        Returns the ``[near, far]`` clipping plane distances
        """
    def set_clip_planes(self, near: float | None=..., far: float | None=...) -> None:
        """
        Sets the near and/or far clipping plane distances. Either value
        may be None to leave it unchanged.
        """
    def is_orthographic(self) -> bool:
        """
        Returns True if this camera uses an orthographic projection
        """
    def set_orthographic(self, state: bool, width: float | None=...) -> None:
        """
        Switches the camera in or out of orthographic projection. If
        ``width`` is given it is applied as the orthographic width.
        """
    def ortho_width(self) -> float:
        """
        Returns the width of the view when the camera is orthographic
        """
    def set_ortho_width(self, width: float) -> None:
        """
        Sets the width of the view used when the camera is orthographic
        """
    def field_of_view(self) -> list[float]:
        """
        Returns the ``[horizontal, vertical]`` field of view in degrees,
        derived from the focal length and film aperture.
        """
    def eye_point(self) -> list[float]:
        """
        Returns the world-space position of the camera's eye point
        """
    def view_direction(self) -> list[float]:
        """
        Returns the normalised world-space direction the camera looks along
        """
    def up_direction(self) -> list[float]:
        """
        Returns the normalised world-space up vector of the camera
        """
    def look_at(self, target: 'list[float]|mref.ReferencedItem|str') -> None:
        """
        Rotates the camera's transform so that it looks at the given
        target, which may be a world-space ``[x, y, z]`` point or a
        node (whose world-space pivot is used). The camera's centre of
        interest is updated to the target distance.
        """

class ClusterTrait:
    """
    Trait bound to any node with ``MFn.kClusterFilter`` — the cluster
    deformer node. (Note that ``MFn.kCluster`` is, somewhat confusingly,
    the ``clusterHandle`` *shape* rather than the deformer.) Exposes the
    handle transform and handle shape, relative mode, the weighted node
    and re-binding of the cluster to the handle's current position.

    Input/output geometry, the envelope and the paintable per-component
    weights are provided by the generic ``GeometryFilter`` trait which is
    also bound to every cluster.
    """
    def handle(self) -> mref.ReferencedItem | None:
        """
        Returns the transform driving the cluster (the node whose
        ``worldMatrix`` feeds the cluster's ``matrix`` input), or None
        if nothing is driving it.
        """
    def handle_shape(self) -> mref.ReferencedItem | None:
        """
        Returns the ``clusterHandle`` shape node which draws the cluster
        in the viewport, or None if there is no handle shape.
        """
    def is_relative(self) -> bool:
        """
        Returns True if the cluster is in relative mode — only the
        handle's local transformation (not that of its parents) affects
        the deformation.
        """
    def set_relative(self, state: bool) -> None:
        """
        Sets whether the cluster is in relative mode
        """
    def weighted_node(self) -> mref.ReferencedItem | None:
        """
        Returns the cluster's weighted node — the transform whose matrix
        is used to deform the geometry. This is normally the cluster
        handle, but can be any transform.
        """
    def set_weighted_node(self, node: mref.ReferencedItem | str) -> None:
        """
        Sets the transform which drives the cluster. Its world matrix is
        connected to the cluster's ``matrix`` input, so :meth:`handle`
        will report this node afterwards.
        """
    def bind_pre_matrix(self) -> list[float]:
        """
        Returns the cluster's ``bindPreMatrix`` as a flat list of sixteen
        floats — the inverse of the handle's matrix at bind time. Maya
        leaves this unset (identity) for a handle created at the origin.
        """
    def rebind(self) -> None:
        """
        Re-binds the cluster to the current position of its handle by
        setting the ``bindPreMatrix`` to the handle's current world
        inverse matrix. Afterwards the handle in its current pose has no
        deforming effect — the geometry returns to its undeformed shape.
        """

class ClusterHandleTrait:
    """
    Trait bound to any node with ``MFn.kCluster`` — the ``clusterHandle``
    shape which draws a cluster in the viewport. Exposes the cluster
    deformer the handle belongs to and the geometry it deforms, matching
    the ``DeformerHandle`` trait for nonLinear handles.

    Note that ``MFn.kCluster`` is the handle shape; the cluster deformer
    node itself is ``MFn.kClusterFilter`` (see the ``Cluster`` trait).
    """
    def deformer(self) -> mref.ReferencedItem | None:
        """
        Returns the cluster deformer this handle belongs to, or None if
        the handle is not connected to a cluster.
        """
    def deformed_geometry(self) -> mref.ReferenceList:
        """
        Returns the shapes deformed by the cluster this handle belongs
        to, or an empty list if the handle has no cluster.
        """

class ConstraintTrait:
    """
    Trait bound to any node with ``MFn.kConstraint`` — point, orient,
    parent, scale, aim, pole-vector, and any other constraint type
    derived from Maya's constraint base. Exposes the constrained node
    (:meth:`driven`), the nodes driving the constraint
    (:meth:`drivers`), and the per-target weight attributes
    (:meth:`weight_attributes`).

    Also provides target management (add / remove / per-target
    weight), offsets, interpolation type, skipped axes, rest position,
    aim/up vector and world-up settings for aim-style constraints, and
    a simple bake-out helper. Getters for settings a given constraint
    type does not have (e.g. :meth:`aim_vector` on a point constraint)
    return None.
    """
    def driven(self) -> mref.ReferencedItem | None:
        """
        Returns the node being driven by the constraint
        """
    def drivers(self) -> mref.ReferenceList:
        """
        Returns the list of driver nodes feeding this constraint's
        target inputs. The constraint's own target hierarchy
        connections (``targetParentMatrix``) are excluded — only true
        driver transforms are returned.
        """
    def weight_attributes(self) -> mref.ReferenceList:
        """
        Returns the per-target weight attributes for the constraint.
        The result is a ``ReferenceList`` of attribute ReferencedItems,
        one entry per target.
        """
    def add_target(self, driver: mref.ReferencedItem | str, weight: float=..., maintain_offset: bool=...) -> mref.ReferencedItem:
        """
        Adds the given node as a new target of this constraint and
        returns its weight attribute. Uses the constraint's own command
        (``cmds.pointConstraint`` etc.), which appends to the existing
        constraint of that type on the driven node. Existing settings
        such as aim vectors are preserved.

        :param weight: The weight of the new target.
        :param maintain_offset: Forwarded as ``maintainOffset``; only
            passed when True since not every constraint command (e.g.
            ``poleVectorConstraint``) supports the flag.
        """
    def remove_target(self, driver: mref.ReferencedItem | str) -> None:
        """
        Removes the given node as a target of this constraint. Note
        that Maya deletes the constraint node itself when its last
        target is removed.
        """
    def target_weight(self, driver: mref.ReferencedItem | str) -> float:
        """
        Returns the weight of the given target. Raises ValueError if
        the node is not a target of this constraint.
        """
    def set_target_weight(self, driver: mref.ReferencedItem | str, weight: float) -> None:
        """
        Sets the weight of the given target. Raises ValueError if the
        node is not a target of this constraint.
        """
    def offset_values(self) -> list[float] | None:
        """
        Returns the constraint-level ``offset`` as ``[x, y, z]`` (point,
        orient, aim and scale constraints — this is what
        ``maintainOffset`` writes to). Returns None for constraint types
        without one; parent constraints store offsets per target, see
        :meth:`target_offset`.

        Named ``offset_values`` rather than ``offset`` so that
        ``constraint.offset`` keeps resolving to the Maya attribute.
        """
    def set_offset_values(self, values: list[float]) -> None:
        """
        Sets the constraint-level ``offset`` from ``[x, y, z]``. Raises
        RuntimeError on constraint types without one.
        """
    def target_offset(self, driver: mref.ReferencedItem | str) -> dict | None:
        """
        Returns the per-target offset of a parent constraint as
        ``{"translate": [x, y, z], "rotate": [x, y, z]}``. Returns None
        for constraint types without per-target offsets. Raises
        ValueError if the node is not a target of this constraint.
        """
    def interpolation_type(self) -> str | None:
        """
        Returns the rotation interpolation type of an orient or parent
        constraint — one of ``"noFlip"``, ``"average"``, ``"shortest"``,
        ``"longest"`` or ``"cache"``. Returns None for constraint types
        without one.
        """
    def set_interpolation_type(self, interpolation_type: str) -> None:
        """
        Sets the rotation interpolation type of an orient or parent
        constraint (see :meth:`interpolation_type` for the names).
        """
    def skipped_axes(self) -> dict[str, list[str]]:
        """
        Returns, for each channel this constraint type can drive
        (``"translate"``, ``"rotate"``, ``"scale"``), the axes that are
        NOT connected to the driven node — e.g. ``{"translate": ["y"]}``
        for a point constraint created with ``skip="y"``. Maya does not
        store skip flags, so this is derived from the output
        connections.
        """
    def rest_position(self) -> dict | None:
        """
        Returns the rest position settings as a dictionary with an
        ``"enabled"`` bool plus whichever of ``"translate"``,
        ``"rotate"`` and ``"scale"`` this constraint type has, each as
        ``[x, y, z]``. Returns None for constraint types without a rest
        position (e.g. pole vector constraints).
        """
    def set_rest_position(self, translate: list[float] | None=..., rotate: list[float] | None=..., scale: list[float] | None=..., enabled: bool | None=...) -> None:
        """
        Sets any of the rest translate / rotate / scale values and
        whether the rest position is enabled. Arguments left as None
        are not changed. Raises RuntimeError if a value is given that
        this constraint type has no rest attribute for.
        """
    def aim_vector(self) -> list[float] | None:
        """
        Returns the aim vector as ``[x, y, z]``, or None if this
        constraint type has no aim vector.
        """
    def set_aim_vector(self, vector: list[float]) -> None:
        """
        Sets the aim vector from ``[x, y, z]``.
        """
    def up_vector(self) -> list[float] | None:
        """
        Returns the up vector as ``[x, y, z]``, or None if this
        constraint type has no up vector.
        """
    def set_up_vector(self, vector: list[float]) -> None:
        """
        Sets the up vector from ``[x, y, z]``.
        """
    def world_up_type(self) -> str | None:
        """
        Returns the world up type as the string used by
        ``cmds.aimConstraint`` — ``"scene"``, ``"object"``,
        ``"objectrotation"``, ``"vector"`` or ``"none"``. Returns None
        if this constraint type has no world up type.
        """
    def set_world_up_type(self, world_up_type: str, world_up_object: mref.ReferencedItem | str | None=..., world_up_vector: list[float] | None=...) -> None:
        """
        Sets the world up type (see :meth:`world_up_type` for names)
        via the constraint's own command, so the world up object's
        matrix is connected for you.

        :param world_up_object: Required by Maya for the ``"object"``
            and ``"objectrotation"`` types.
        :param world_up_vector: Optional ``[x, y, z]`` world up vector
            (used by ``"vector"`` and ``"objectrotation"``).
        """
    def world_up_object(self) -> mref.ReferencedItem | None:
        """
        Returns the node whose matrix feeds the world up of an
        aim-style constraint, or None if there is none.
        """
    def bake(self, start: float | None=..., end: float | None=..., delete_constraint: bool=...) -> None:
        """
        Bakes the constrained channels of the driven node to keys over
        the given frame range (defaults to the playback range) and, by
        default, deletes this constraint afterwards. Only the channels
        this constraint actually drives are baked.
        """

class ConstructionHistoryTrait:
    """
    Trait bound to Maya's poly and NURBS construction-history nodes —
    any node with ``MFn.kPolyCreator`` (``polyCreator``: polyCube,
    polyPlane, polyUnite, ...), ``MFn.kMidModifier`` (``polyModifier``:
    polyExtrudeFace, polySmoothFace, polyBevel3, ...) or ``MFn.kCreate``
    (``abstractBaseCreate``: makeNurbSphere, makeNurbCircle, loft,
    revolve, extrude, ...). Deformers are not construction history in
    this sense and are handled by ``GeometryFilter``.

    Exposes the geometry flowing in and out of the node, the shapes it
    ultimately feeds, the rest of the history chain it is part of,
    enabling / disabling it, and baking history out of the shapes it
    feeds while keeping their deformers.

    Geometry connections are found by attribute type: a connection
    counts if either end is a typed mesh / NURBS curve / NURBS surface /
    subdiv attribute, or both ends are generic attributes (groupParts,
    deformer input / output geometry). Message, matrix and numeric
    connections are ignored.
    """
    def geometry_inputs(self) -> mref.ReferenceList:
        """
        Returns the nodes directly feeding geometry into this node — the
        upstream history node or shape. Creator nodes with no geometry
        input (polyCube, makeNurbSphere, ...) return an empty list.
        """
    def geometry_outputs(self) -> mref.ReferenceList:
        """
        Returns the nodes this node directly feeds geometry into — the
        next history node, deformer or shape downstream.
        """
    def output_shapes(self, include_intermediate: bool=...) -> mref.ReferenceList:
        """
        Returns the shapes this node's geometry ends up in. The geometry
        is followed downstream through other history nodes, deformers and
        intermediate (original) shapes until a visible shape is reached,
        so for a deformed mesh this is the final deformed shape. Pass
        ``include_intermediate=True`` to also include any intermediate
        shapes passed along the way.
        """
    def upstream_history(self) -> mref.ReferenceList:
        """
        Returns the construction-history nodes upstream of this one in
        the same chain, nearest first, stopping at the first shape. For
        ``polyCube -> polyExtrudeFace -> polyBevel3`` the bevel returns
        ``[polyExtrudeFace, polyCube]``.
        """
    def downstream_history(self) -> mref.ReferenceList:
        """
        Returns the construction-history nodes downstream of this one in
        the same chain, nearest first, stopping at the first shape. For
        ``polyCube -> polyExtrudeFace -> polyBevel3`` the cube returns
        ``[polyExtrudeFace, polyBevel3]``.
        """
    def is_enabled(self) -> bool:
        """
        Returns True if this node is contributing to the geometry, or
        False if its ``nodeState`` has been set to "Has No Effect" (or
        any other non-normal state).
        """
    def set_enabled(self, state: bool) -> None:
        """
        Enables or disables this node. Disabling sets ``nodeState`` to
        "Has No Effect", so a modifier passes its input geometry through
        unchanged — useful to preview geometry without an operation
        without deleting it.
        """
    def bake_history_on_outputs(self) -> mref.ReferenceList:
        """
        Bakes the construction history of every shape this node feeds
        (see :meth:`output_shapes`) into the shape, then removes the
        history. This affects the whole non-deformer history of those
        shapes, not only this node, and this node itself is typically
        deleted as a result.

        Unlike ``cmds.delete(constructionHistory=True)`` this is safe on
        deformed geometry: deformers (skin clusters, blendshapes, ...)
        are kept and keep working, only the modelling history beneath
        them is baked. Returns the shapes that were baked.
        """

class ContainerTrait:
    """
    Trait bound to any node with ``MFn.kContainerBase`` — asset
    containers (``container``) and DAG containers (``dagContainer``).
    Exposes the member nodes, the published (bound) attributes, and the
    parent / child container hierarchy.

    Note that ``animLayer`` nodes derive from ``containerBase`` in the
    node-type hierarchy but do not report ``kContainerBase``, so they
    are not bound.
    """
    def member_nodes(self) -> mref.ReferenceList:
        """
        Returns the nodes which are direct members of this container.
        Nested containers are returned as members, but not their
        contents.
        """
    def add_member_nodes(self, nodes: list | mref.ReferencedItem | str, include_network: bool=...) -> None:
        """
        Adds the given node(s) to this container. If ``include_network``
        is True then the upstream and downstream nodes connected to them
        are added too, mirroring Maya's "include network" option.
        """
    def remove_member_nodes(self, nodes: list | mref.ReferencedItem | str) -> None:
        """
        Removes the given node(s) from this container. The nodes
        themselves are kept in the scene.
        """
    def is_member_node(self, node: mref.ReferencedItem | str) -> bool:
        """
        Returns True if the given node is a direct member of this
        container.
        """
    def published_attributes(self) -> dict:
        """
        Returns the published attributes of this container as a dict of
        ``{published_name: attribute}`` where ``attribute`` is the
        ReferencedItem of the member-node attribute bound to that name.
        Published names which are not bound to any attribute are
        omitted.
        """
    def publish_attribute(self, attribute: mref.ReferencedItem | str, published_name: str=...) -> None:
        """
        Publishes the given member-node attribute on this container under
        ``published_name`` (defaulting to the attribute's own long name)
        and binds it.
        """
    def unpublish_attribute(self, published_name: str) -> None:
        """
        Unbinds and removes the published attribute with the given
        published name.
        """
    def parent_container(self) -> mref.ReferencedItem | None:
        """
        Returns the container this container is nested within, or None
        if it is a top-level container.
        """
    def child_containers(self) -> mref.ReferenceList:
        """
        Returns the containers nested directly within this container
        """

class DagNodeTrait:
    """
    Trait bound to any node with ``MFn.kDagNode`` — transforms, joints,
    locators, all shape types, and anything else that lives in the DAG
    hierarchy. Exposes parent/child traversal, DAG-path queries, shape
    access, and constraint discovery.

    Priority ``0`` (the default), so it sits above ``DependencyNode``
    (``-1``) in the resolution order — ``full_name()`` returns the DAG
    path rather than the short name for any DAG node.
    """
    def full_name(self) -> str:
        """
        Returns the full path (long) name of the node.
        """
    def children(self, recursive: bool=..., node_type: str=..., name_match: str=..., include_shapes: bool=...) -> list[mref.ReferencedItem]:
        """
        Returns a list of children of the node.

        Args:
            recursive (bool, optional): If False (default) only immediate
                children will be returned. If True all descendants will be
                returned.
            node_type (str, optional): Only return children of the specified
                Maya node type.
            name_match (str, optional): Substring filter on the child's short
                name. Only children whose short name contains this substring
                are returned. Matching is case-sensitive.
            include_shapes (bool, optional): If True (default), shape children
                are included in the result. Set to False to skip shapes —
                useful when iterating only transform children.

        Returns:
            A list of mref.ReferencedItem instances.
        """
    def parent(self) -> mref.ReferencedItem | None:
        """
        Returns the parent of this node, or None if this node is at the
        scene root.
        """
    def all_parents(self) -> list[mref.ReferencedItem]:
        """
        Returns all the parents of this node
        """
    def set_parent(self, parent: mref.ReferencedItem | str | None) -> None:
        """
        This will set the parent of the current node. If the parent being
        passed is None, then this node will be parented to the scene root.
        """
    def add_child(self, child: mref.ReferencedItem | str) -> None:
        """
        This will make the given node a child of this node. Goes through
        ``cmds.parent`` so the operation is recorded in Maya's undo stack.
        No-ops if ``child`` is this node itself, or if ``child`` is
        already parented to this node.
        """
    def add_children(self, children: list[mref.ReferencedItem | str]) -> None:
        """
        This will make all the given nodes children of this node. Issued
        as a single ``cmds.parent`` call so the operation is recorded as
        one entry in Maya's undo stack. Children that are this node
        itself, or are already parented to this node, are silently
        skipped — matching ``add_child``'s guard behaviour.
        """
    def dag(self) -> om.MFnDagNode:
        """
        This will return the MFnDagNode object of the current node
        """
    def shapes(self) -> list[mref.ReferencedItem]:
        """
        Returns a list of shapes belonging to the current node
        """
    def shape(self) -> mref.ReferencedItem | None:
        """
        Returns the first shape belonging to this node, or None if it
        has none.
        """
    def constraints(self) -> mref.ReferenceList:
        """
        Returns the constraint nodes parented under this node.

        Limitation: only finds constraints that are direct children of
        this node, which is the conventional Maya layout for constraints
        driving a transform. Constraints that target this node but live
        elsewhere in the scene (custom rigs, exported skeletons, certain
        pipeline conventions) are not returned by this method. Walk the
        connection graph (``listConnections`` on the constraint output
        plugs) for those cases.

        Uses Maya's type-inheritance check (``isAType="constraint"``)
        rather than a substring match on the type name, so user-defined
        nodes whose type name happens to contain ``"constraint"`` won't
        be falsely included.
        """
    def has_zeroed_pivots(self, tolerance=...):
        """
        Return True if the transform has reset/frozen pivots.

        Checks that rotatePivot, scalePivot, rotatePivotTranslate and
        scalePivotTranslate are all at the origin. Accepts either a transform
        or a shape name.
        """
    def lock_transform_attributes(self, hide=...) -> None:
        """
        Locks the nine scalar transform channels on this node — translateX/Y/Z,
        rotateX/Y/Z, scaleX/Y/Z. Does not lock visibility, nor the parent
        compound translate/rotate/scale attributes themselves. Has no unlock
        counterpart; call ``unlock_attributes`` with explicit channel names
        to reverse.
        """
    def unlock_transform_attributes(self, hide=...) -> None:
        """
        Unlocks the nine scalar transform channels on this node — translateX/Y/Z,
        rotateX/Y/Z, scaleX/Y/Z — reversing ``lock_transform_attributes``.
        Does not touch visibility, nor the parent compound
        translate/rotate/scale attributes themselves.
        """
    def dag_path(self) -> om.MDagPath:
        """
        Returns the MDagPath of this node. For an instanced node this is
        the path of the first instance.
        """
    def root(self) -> mref.ReferencedItem:
        """
        Returns the top-most ancestor of this node (the node directly
        under the scene root), or this node itself if it has no parent.
        """
    def siblings(self, include_shapes: bool=...) -> mref.ReferenceList:
        """
        Returns the other children of this node's parent, not including
        this node. For a node at the scene root this is the other
        top-level nodes (including the default cameras).

        :param include_shapes: If False, shape nodes are skipped.
        """
    def instance_count(self) -> int:
        """
        Returns the number of DAG paths to this node — 1 for a node that
        is not instanced. Includes indirect instancing (an instanced
        parent).
        """
    def is_instanced(self) -> bool:
        """
        Returns True if this node can be reached by more than one DAG
        path, either directly or through an instanced parent.
        """
    def is_visible(self) -> bool:
        """
        Returns True if this node is actually drawn — i.e. it and all of
        its parents are visible (taking ``visibility``, ``lodVisibility``,
        drawing overrides and intermediate state into account). This
        differs from reading the ``visibility`` attribute, which ignores
        the parents.
        """
    def show(self) -> None:
        """
        Sets this node's ``visibility`` attribute on. Parents that are
        hidden will still hide it — see ``is_visible``.
        """
    def hide(self) -> None:
        """
        Sets this node's ``visibility`` attribute off.
        """
    def world_matrix(self, inverse: bool=...) -> list[float]:
        """
        Returns the world-space matrix of this node as a flat list of 16
        floats, read directly from the DAG path. Works for shapes as well
        as transforms (a shape returns its transform's world matrix).

        :param inverse: If True, returns the inverse world matrix.
        """
    def outliner_colour(self) -> tuple[float, float, float] | None:
        """
        Returns the custom outliner colour as an ``(r, g, b)`` tuple, or
        None if the node does not use a custom outliner colour.
        """
    def set_outliner_colour(self, colour: 'tuple[float, float, float]|None') -> None:
        """
        Sets the colour this node's name is drawn with in the outliner,
        as ``(r, g, b)`` floats in the 0-1 range. Pass None to go back to
        the default colour.
        """
    def display_override(self) -> str:
        """
        Returns the drawing-override display type of this node:
        ``"normal"``, ``"template"`` or ``"reference"`` (unselectable).
        Returns ``"normal"`` when drawing overrides are not enabled.
        """
    def set_display_override(self, display_type: str) -> None:
        """
        Sets the drawing-override display type of this node to
        ``"normal"``, ``"template"`` or ``"reference"`` (unselectable).
        Setting template or reference enables drawing overrides; setting
        normal leaves ``overrideEnabled`` alone so that any override
        colour set on the node is kept.
        """

class DeformerHandleTrait:
    """
    Trait bound to any node with ``MFn.kDeformFunc`` — the handle
    shapes of the nonLinear deformers (``deformBend``, ``deformTwist``,
    ``deformFlare``, ``deformSine``, ``deformSquash`` and
    ``deformWave``). Exposes the nonLinear deformer the handle drives,
    its deformer type and the geometry it deforms.

    The handle's parameter attributes (curvature, bounds, ...) are
    driven by the deformer, so edit them through the deformer's
    ``set_parameter``.
    """
    def deformer(self) -> mref.ReferencedItem | None:
        """
        Returns the nonLinear deformer this handle belongs to, or None
        if the handle is not connected to a deformer.
        """
    def deformer_type(self) -> str:
        """
        Returns the type of deformer this handle represents — one of
        ``"bend"``, ``"twist"``, ``"flare"``, ``"sine"``, ``"squash"``
        or ``"wave"``.
        """
    def deformed_geometry(self) -> mref.ReferenceList:
        """
        Returns the shapes deformed by the deformer this handle belongs
        to, or an empty list if the handle has no deformer.
        """

class DependencyNodeTrait:
    """
    Trait bound to every node in the scene — ``MFn.kDependencyNode`` is
    the root of Maya's node-type hierarchy, so every node has this trait.
    Provides the foundational name, attribute, lock, and connection API.

    Priority ``-1`` (lowest), so higher-priority traits like ``DagNode``
    (priority ``0``) override this trait's methods when they apply. In
    particular, ``DagNode.full_name()`` shadows this trait's
    ``full_name()`` for any node that lives in the DAG hierarchy.
    """
    def name(self) -> str:
        """
        Returns the name of the node which is referenced
        """
    def full_name(self) -> str:
        """
        Returns the full name of the node which is referenced
        """
    def rename(self, new_name: str) -> None:
        """
        Renames this node to the given name
        """
    def attribute(self, attribute_name: str) -> mref.ReferencedItem | None:
        """
        Gets the attribute on this node by name. Returns None if the
        node does not have an attribute with that name.

        Note: this differs from accessing the attribute via property
        syntax (``node.translateX``), which raises ``AttributeError``
        for unknown names. Use this method when you want to test for
        an attribute's existence without exception handling; use the
        property form when an unknown name is a programming error
        you'd like surfaced loudly.
        """
    def attr(self, attribute_name: str) -> mref.ReferencedItem | None:
        """
        Gets the attribute on this node by the attribute name
        """
    def attributes(self, **kwargs) -> list[mref.ReferencedItem]:
        """
        Returns a list of all attributes on this node
        """
    def add_attribute(self, name: str, value: typing.Any, attribute_type: str, **kwargs) -> mref.ReferencedItem:
        """
        Adds an attribute to this node with the given name and type. If
        ``value`` is not None, the new attribute is also initialised to
        that value; ``None`` means "create the attribute but leave the
        default value in place".

        Note: ``attribute_type="compound"`` is not supported by this
        method — Maya requires a different code path (``numberOfChildren``
        followed by per-child ``addAttr`` calls) which this function
        does not implement. Calling with a compound type raises
        ``KeyError`` from the constants lookup. Use ``cmds.addAttr``
        directly to create compound attributes.
        """
    def add_proxy(self, name, source_attribute, keyable=..., **kwargs):
        """
        Adds a proxy attribute to this node
        """
    def add_separator_attribute(self): ...
    def has_attribute(self, attribute_name: str) -> bool:
        """
        Returns True if this node has an attribute with the given name,
        False otherwise.
        """
    def node_type(self) -> str:
        """
        Returns the type of this node
        """
    def uuid(self) -> str:
        """
        Returns the node's UUID as a string. Unlike the name, this stays
        the same when the node is renamed or reparented, and is saved
        with the scene.
        """
    def exists(self) -> bool:
        """
        Returns True if the node this item points at still exists in the
        scene. Returns False once the node has been deleted, even if the
        deletion is still sitting in the undo queue.
        """
    def is_referenced(self) -> bool:
        """
        Returns True if this node was brought into the scene by a file
        reference (and so cannot be renamed, deleted or reparented).
        """
    def reference_node(self) -> mref.ReferencedItem | None:
        """
        Returns the reference node (``fooRN``) that brought this node
        into the scene, or None if the node is not referenced.
        """
    def is_default_node(self) -> bool:
        """
        Returns True if this is one of the nodes Maya creates in every
        scene (``time1``, ``lambert1``, ``persp`` etc.) and which cannot be
        deleted.
        """
    def node_namespace(self) -> str:
        """
        Returns the namespace this node lives in, without a leading colon
        (``char:rig`` for a nested namespace), or an empty string for the
        root namespace.

        Named ``node_namespace`` rather than ``namespace`` so it does not
        clash with ``Reference.namespace()``, which returns the namespace
        of a reference's *contents* rather than of the node itself.
        """
    def set_node_namespace(self, namespace: str) -> None:
        """
        Moves this node into the given namespace, keeping its base name.
        The namespace (and any missing parents of a nested ``a:b``
        namespace) is created if it does not exist. Pass an empty string
        to move the node back to the root namespace.
        """
    def select(self, add: bool=...) -> None:
        """
        Selects this node, replacing the current selection unless ``add``
        is True.
        """
    def duplicate(self, name: str=..., **kwargs) -> mref.ReferencedItem:
        """
        Duplicates this node and returns the duplicate. Any additional
        kwargs are passed to ``cmds.duplicate`` (for example
        ``upstreamNodes=True`` or ``inputConnections=True``). For DAG
        nodes the duplicate of this node is returned, not its children.
        """
    def node_notes(self) -> str:
        """
        Returns the text shown in the Notes section of the Attribute
        Editor, or an empty string if the node has no notes.

        Named ``node_notes`` because ``notes`` is the name of the Maya
        attribute that stores them, and a method of that name would
        shadow property-style access to it.
        """
    def set_node_notes(self, text: str) -> None:
        """
        Sets the text shown in the Notes section of the Attribute Editor,
        creating the ``notes`` attribute if the node does not have one.
        """
    def plug_connections(self, source: bool=..., destination: bool=...) -> list[tuple[mref.ReferencedItem, mref.ReferencedItem]]:
        """
        Returns this node's connections as ``(source_plug,
        destination_plug)`` tuples of attribute ReferencedItems, always
        ordered in the direction data flows.

        :param source: Include incoming connections (where this node's
            plug is the destination).
        :param destination: Include outgoing connections (where this
            node's plug is the source).
        """
    def history(self, node_type: str=..., **kwargs) -> mref.ReferenceList:
        """
        Returns the nodes upstream of this node, nearest first, using
        ``cmds.listHistory`` (so a transform's history includes its
        shape's). The node itself is not included. Any additional kwargs
        are passed to ``cmds.listHistory`` (for example
        ``pruneDagObjects=True`` or ``levels=1``).

        :param node_type: Only return nodes of this type, or of a type
            derived from it (``"geometryFilter"`` returns all deformers).
        """
    def future(self, node_type: str=..., **kwargs) -> mref.ReferenceList:
        """
        Returns the nodes downstream of this node, nearest first, using
        ``cmds.listHistory(future=True)``. The node itself is not
        included. Any additional kwargs are passed to
        ``cmds.listHistory``.

        :param node_type: Only return nodes of this type, or of a type
            derived from it.
        """
    def inputs(self, shapes: bool=..., **kwargs) -> list[mref.ReferencedItem]:
        """
        Returns a list of inputs coming into this node.

        :param shapes: If True (default), shape nodes connected to this
            node are also included. Set to False to match
            ``cmds.listConnections``' default behaviour.
        """
    def outputs(self, shapes: bool=..., **kwargs) -> list[mref.ReferencedItem]:
        """
        Returns a list of outputs coming out of this node.

        :param shapes: If True (default), shape nodes connected to this
            node are also included. Set to False to match
            ``cmds.listConnections``' default behaviour.
        """
    def delete(self) -> None:
        """
        This will remove the node from the scene
        """
    def lock(self) -> None:
        """
        This will lock the node
        """
    def unlock(self) -> None:
        """
        This will unlock the node
        """
    def is_locked(self) -> bool:
        """
        This will return whether or not the node is locked
        """
    def set_lock_state(self, state: bool) -> None:
        """
        This will set the nodes lock state to the given state
        """
    def lock_attributes(self, attribute_names: list[str]) -> None:
        """
        Lock the named attributes on this node. Each name is resolved
        against this node; raises AttributeError if any name is unknown.
        """
    def unlock_attributes(self, attribute_names: list[str]) -> None:
        """
        Unlock the named attributes on this node. Each name is resolved
        against this node; raises AttributeError if any name is unknown.
        """
    def __getattr__(self, name: str) -> Attribute:
        """Resolves a Maya attribute on this node, e.g. ``node.translateX``."""

class DisplayLayerTrait:
    """
    Trait bound to any node with ``MFn.kDisplayLayer`` — display layers.
    Exposes layer membership along with the layer's visibility, display
    type (normal / template / reference), hide-on-playback flag and
    colour index.

    Display layers are not ``kSet`` nodes, so the ``ObjectSet`` trait
    never binds alongside this one and the ``members`` /
    ``add_members`` / ``remove_members`` names are free to use here.
    """
    def members(self) -> mref.ReferenceList:
        """
        Returns the nodes which belong to this display layer
        """
    def add_members(self, members: 'list|mref.ReferencedItem|str') -> None:
        """
        Adds the given node(s) to this display layer. A node can only be
        in one display layer, so they are removed from any other layer.
        """
    def remove_members(self, members: 'list|mref.ReferencedItem|str') -> None:
        """
        Removes the given node(s) from this display layer by moving them
        back to the ``defaultLayer``. Nodes that are not members of this
        layer are left untouched.
        """
    def is_visible(self) -> bool:
        """
        Returns True if the layer's visibility (V) toggle is on
        """
    def set_visible(self, state: bool) -> None:
        """
        Sets the layer's visibility (V) toggle
        """
    def display_type(self) -> str:
        """
        Returns the layer's display type: ``"normal"``, ``"template"``
        or ``"reference"``.
        """
    def set_display_type(self, display_type: str) -> None:
        """
        Sets the layer's display type: ``"normal"``, ``"template"`` or
        ``"reference"``.
        """
    def hide_on_playback(self) -> bool:
        """
        Returns True if the layer's members are hidden during playback
        (the layer editor's P toggle being off)
        """
    def set_hide_on_playback(self, state: bool) -> None:
        """
        Sets whether the layer's members are hidden during playback
        """
    def colour_index(self) -> int:
        """
        Returns the layer's colour index (``0`` means no colour)
        """
    def set_colour_index(self, index: int) -> None:
        """
        Sets the layer's colour index (``0`` to ``31``; ``0`` means no
        colour). RGB layer colours are switched off so the index is used.
        """

class DistanceDimensionTrait:
    """
    Trait bound to any node with ``MFn.kDistance`` — distance dimension
    shapes (``distanceDimShape``) which measure the distance between two
    points, usually driven by two locators. Exposes the measured
    distance, the start / end locators (and rewiring them), and the
    start / end point positions.
    """
    def distance(self) -> float:
        """
        Returns the measured distance between the start and end points
        """
    def start_locator(self) -> mref.ReferencedItem | None:
        """
        Returns the locator shape driving the start point, or None
        """
    def end_locator(self) -> mref.ReferencedItem | None:
        """
        Returns the locator shape driving the end point, or None
        """
    def set_start_locator(self, locator: 'mref.ReferencedItem|str') -> None:
        """
        Drives the start point from the given locator (transform or
        shape) by connecting its ``worldPosition[0]``.
        """
    def set_end_locator(self, locator: 'mref.ReferencedItem|str') -> None:
        """
        Drives the end point from the given locator (transform or shape)
        by connecting its ``worldPosition[0]``.
        """
    def start_position(self) -> list[float]:
        """
        Returns the world-space start point ``[x, y, z]``
        """
    def end_position(self) -> list[float]:
        """
        Returns the world-space end point ``[x, y, z]``
        """

class ExpressionTrait:
    """
    Trait bound to any node with ``MFn.kExpression`` — expression nodes
    created by ``cmds.expression``. Exposes the expression text, the
    object it is bound to, whether it is time-driven, and the attributes
    it reads from and writes to.

    Maya inserts ``unitConversion`` nodes between an expression and any
    angular attribute it reads or writes; :meth:`input_attributes` and
    :meth:`output_attributes` look through those so the real scene
    attributes are returned.
    """
    def expression_string(self) -> str:
        """
        Returns the expression text. Maya rewrites attribute references
        to their long names (``box.tx`` becomes ``box.translateX``).
        """
    def set_expression_string(self, expression: str) -> None:
        """
        Replaces the expression text. Maya re-parses it and rebuilds the
        input / output connections to match.
        """
    def bound_object(self) -> mref.ReferencedItem | None:
        """
        Returns the object the expression is bound to (the node that
        unqualified attribute names in the expression refer to), or None
        if it is not bound to an object.
        """
    def set_bound_object(self, node: mref.ReferencedItem | str) -> None:
        """
        Binds the expression to the given object
        """
    def is_animated(self) -> bool:
        """
        Returns True if the expression is evaluated whenever time changes
        (Maya's "always evaluate"), rather than only when its inputs
        change.
        """
    def set_animated(self, state: bool) -> None:
        """
        Sets whether the expression is evaluated whenever time changes
        """
    def input_attributes(self) -> mref.ReferenceList:
        """
        Returns the scene attributes the expression reads from, looking
        through any unitConversion nodes Maya inserted.
        """
    def output_attributes(self) -> mref.ReferenceList:
        """
        Returns the scene attributes the expression writes to, looking
        through any unitConversion nodes Maya inserted.
        """

class FileTextureTrait:
    """
    Trait bound to any node with ``MFn.kFileTexture`` — Maya ``file``
    texture nodes. Exposes the texture path, colour space, UV tiling
    (UDIM) mode, resolution of the path (environment variables, project
    relative paths and tile tokens) to the files on disk, and the
    ``place2dTexture`` node driving the texture's UVs.
    """
    def file_path(self) -> str:
        """
        Returns the texture path exactly as stored on the node
        (``fileTextureName``), including any tokens such as ``<UDIM>``.
        """
    def set_file_path(self, path: str) -> None:
        """
        Sets the texture path (``fileTextureName``). Tokens such as
        ``<UDIM>`` are kept as-is.
        """
    def colour_space(self) -> str:
        """
        Returns the name of the input colour space of the texture
        """
    def set_colour_space(self, name: str) -> None:
        """
        Sets the input colour space of the texture. File rules are
        disabled on the node (``ignoreColorSpaceFileRules``) so the
        explicit choice is not overridden when the path changes.
        """
    def tiling_mode(self) -> str:
        """
        Returns the UV tiling mode as one of ``"off"``, ``"zbrush"``,
        ``"mudbox"``, ``"udim"`` or ``"explicit"``.
        """
    def set_tiling_mode(self, mode: str) -> None:
        """
        Sets the UV tiling mode — one of ``"off"``, ``"zbrush"``,
        ``"mudbox"``, ``"udim"`` or ``"explicit"``.
        """
    def is_tiled(self) -> bool:
        """
        Returns True if the texture uses any UV tiling mode (UDIM etc)
        """
    def resolved_paths(self) -> list[str]:
        """
        Returns the absolute paths of the texture files on disk. Environment
        variables and project-relative paths are expanded. For tiled or
        sequence textures, tile/frame tokens (``<UDIM>``, ``<UVTILE>``,
        ``<u>``/``<v>``, ``<f>``, ``#``) are expanded against the files that
        exist on disk, returned sorted. For a plain path the single expanded
        path is returned whether or not it exists; an empty path returns
        an empty list.
        """
    def file_exists(self) -> bool:
        """
        Returns True if the texture file exists on disk. For tiled
        textures this is True if at least one tile exists.
        """
    def place2d_texture(self) -> mref.ReferencedItem | None:
        """
        Returns the ``place2dTexture`` node driving this texture's UV
        coordinates, or None if it is not connected to one.
        """

class FollicleTrait:
    """
    Trait bound to any node with ``MFn.kFollicle`` — follicle shape
    nodes, used both for hair systems and as surface-pinned rivets.
    Exposes the UV parameters, the mesh or NURBS surface the follicle
    is attached to, attaching / detaching it, driving the follicle's
    transform from its outputs, the evaluated world position, rotation
    and normal, and the hair system it feeds.
    """
    def parameter_u(self) -> float:
        """
        Returns the U parameter (0-1) at which the follicle sits
        """
    def set_parameter_u(self, value: float) -> None:
        """
        Sets the U parameter (0-1) at which the follicle sits
        """
    def parameter_v(self) -> float:
        """
        Returns the V parameter (0-1) at which the follicle sits
        """
    def set_parameter_v(self, value: float) -> None:
        """
        Sets the V parameter (0-1) at which the follicle sits
        """
    def surface(self) -> mref.ReferencedItem | None:
        """
        Returns the mesh or NURBS surface shape the follicle is attached
        to (the source of ``inputMesh`` or ``inputSurface``), or None if
        it is not attached.
        """
    def attach_to(self, shape: 'mref.ReferencedItem|str', u: float | None=..., v: float | None=..., drive_transform: bool=...) -> None:
        """
        Attaches the follicle to a mesh or NURBS surface. A transform
        may be given, in which case its first shape is used. Connects
        ``worldMatrix[0]`` to ``inputWorldMatrix`` and either
        ``outMesh`` to ``inputMesh`` or ``local`` to ``inputSurface``.

        Optionally sets the U / V parameters, and when
        ``drive_transform`` is True (default) wires the follicle's
        outputs onto its transform (see :meth:`drive_transform`).
        """
    def detach(self) -> None:
        """
        Disconnects the follicle from the surface it is attached to
        (``inputMesh``, ``inputSurface`` and ``inputWorldMatrix``).
        """
    def drive_transform(self) -> None:
        """
        Connects ``outTranslate`` / ``outRotate`` to the translate and
        rotate of the follicle's transform, so the transform rides the
        surface. This is the standard rivet / hair follicle setup.
        """
    def world_position(self) -> list[float]:
        """
        Returns the evaluated world-space position ``[x, y, z]`` of the
        follicle on its surface (``outTranslate``).
        """
    def world_rotation(self) -> list[float]:
        """
        Returns the evaluated world-space rotation ``[x, y, z]`` in
        degrees of the follicle on its surface (``outRotate``).
        """
    def surface_normal(self) -> list[float]:
        """
        Returns the evaluated surface normal ``[x, y, z]`` at the
        follicle's position (``outNormal``).
        """
    def hair_system(self) -> mref.ReferencedItem | None:
        """
        Returns the hair system shape this follicle feeds (via
        ``outHair``), or None if it is not part of a hair system.
        """

class GeometryFilterTrait:
    """
    Trait bound to any node with ``MFn.kGeometryFilt`` — the base of every
    deformer in Maya (skin clusters, blendshapes, clusters, lattices,
    wires, nonlinears, delta mush, tension and so on). Exposes the
    geometry being deformed, the envelope, and per-component deformer
    weights.

    Priority ``0``. Deformer-specific traits (``SkinCluster``,
    ``Blendshape``, ``Cluster``, ...) sit at priority ``1`` so their
    more specific behaviour wins where method names overlap.
    """
    def input_geometry(self) -> mref.ReferenceList:
        """
        Returns the shapes feeding into this deformer
        """
    def output_geometry(self) -> mref.ReferenceList:
        """
        Returns the shapes this deformer is deforming
        """
    def envelope(self) -> float:
        """
        Returns the envelope value of the deformer
        """
    def set_envelope(self, value: float) -> None:
        """
        Sets the envelope value of the deformer
        """
    def geometry_index(self, shape: mref.ReferencedItem | str) -> int:
        """
        Returns the plug index this deformer uses for the given output
        shape. This is the index into ``input[]``, ``outputGeometry[]``
        and ``weightList[]``.
        """
    def deformer_weights(self, shape: mref.ReferencedItem | str=...) -> list[float]:
        """
        Returns the per-component deformer weights (the paintable
        ``weightList`` values) for the given shape, or the first output
        shape when no shape is given. Components with no stored value
        report Maya's default of ``1.0``.

        The shape must support the skinnable-shape protocol
        (``component_count()``), which ``Mesh``, ``NurbsCurve`` and
        ``NurbsSurface`` provide.

        On blendshapes in Maya 2024 and earlier these are read from
        ``inputTarget[n].baseWeights``, which is where those versions
        store the painted base weights.
        """
    def set_deformer_weights(self, weights: list[float], shape: mref.ReferencedItem | str=...) -> None:
        """
        Sets the per-component deformer weights for the given shape, or
        the first output shape when no shape is given. ``weights`` must
        have exactly one entry per component.
        """

class IkEffectorTrait:
    """
    Trait bound to any node with ``MFn.kIkEffector`` — the end effector
    which sits at the tip of an IK chain. Exposes the IK handle(s) the
    effector serves and the joints at either end of the chain.

    ``IkHandle.effector()`` provides the reverse lookup, from handle to
    effector.
    """
    def ik_handle(self) -> mref.ReferencedItem | None:
        """
        Returns the IK handle this effector serves, or None if the
        effector is not connected to a handle.
        """
    def ik_handles(self) -> mref.ReferenceList:
        """
        Returns every IK handle this effector serves. ``handlePath`` is
        a multi attribute, so an effector can feed more than one handle.
        """
    def end_joint(self) -> mref.ReferencedItem | None:
        """
        Returns the joint the effector sits on (the last joint of the
        chain), or None if the effector is not driven by a joint.
        """
    def start_joint(self) -> mref.ReferencedItem | None:
        """
        Returns the first joint of the chain driven by this effector's
        IK handle, or None if the effector has no handle.
        """

class IkHandleTrait:
    """
    Trait bound to any node with ``MFn.kIkHandle`` — IK handles (RP, SC,
    spline and spring solvers). Exposes the start / end joints, the end
    effector, the joint chain being driven, the solver type, and the
    pole vector and twist controls.

    The OpenMaya 2.0 API has no ``MFnIkHandle``, so this trait works
    through ``cmds.ikHandle`` and the handle's plugs.
    """
    def start_joint(self) -> mref.ReferencedItem | None:
        """
        Returns the first joint of the chain driven by this handle, or
        None if the handle is not connected to a chain.
        """
    def end_joint(self) -> mref.ReferencedItem | None:
        """
        Returns the last joint of the chain driven by this handle (the
        joint the end effector sits on), or None if there is no effector.
        """
    def effector(self) -> mref.ReferencedItem | None:
        """
        Returns the end effector node of this handle, or None if the
        handle has no effector.
        """
    def joint_chain(self) -> mref.ReferenceList:
        """
        Returns the joints driven by this handle, ordered from the start
        joint to the end joint (inclusive of both).
        """
    def solver_type(self) -> str | None:
        """
        Returns the node type of the solver driving this handle, such as
        ``"ikRPsolver"``, ``"ikSCsolver"`` or ``"ikSplineSolver"``, or None
        if no solver is connected.
        """
    def set_solver_type(self, solver: str) -> None:
        """
        Switches this handle to the given solver type, e.g. ``"ikRPsolver"``
        or ``"ikSCsolver"``. The solver node is created if it does not yet
        exist in the scene.
        """
    def pole_vector(self) -> list[float]:
        """
        Returns the pole vector as ``[x, y, z]``. Only meaningful for
        rotate-plane style solvers.
        """
    def set_pole_vector(self, vector: list[float]) -> None:
        """
        Sets the pole vector from ``[x, y, z]``. Only meaningful for
        rotate-plane style solvers.
        """
    def add_pole_vector_constraint(self, target: mref.ReferencedItem | str) -> mref.ReferencedItem:
        """
        Creates a pole vector constraint driving this handle from the given
        target transform and returns the constraint node.
        """
    def twist(self) -> float:
        """
        Returns the twist value of the handle in degrees.
        """
    def set_twist(self, value: float) -> None:
        """
        Sets the twist value of the handle in degrees.
        """

class JointTrait:
    """
    Trait bound to any node with ``MFn.kJoint`` — skeleton joints.
    Exposes the joint-specific channels (joint orient, preferred angle,
    segment scale compensate, radius), joint-only hierarchy traversal
    (:meth:`parent_joint`, :meth:`child_joints`, :meth:`chain_to`) and
    the common rigging orientation operations (:meth:`orient_to_child`,
    :meth:`orient_to_world`, :meth:`freeze_rotation`).

    All angles are in degrees.
    """
    def joint_orient(self) -> list[float]:
        """
        Returns the joint orient as ``[x, y, z]`` Euler angles in degrees.
        """
    def set_joint_orient(self, orient: list[float]) -> None:
        """
        Sets the joint orient from ``[x, y, z]`` Euler angles in degrees.
        Note that this changes the world orientation of the joint (and
        so moves its children) — use :meth:`orient_to_child` or
        :meth:`freeze_rotation` to re-orient without moving anything.
        """
    def preferred_angle(self) -> list[float]:
        """
        Returns the preferred angle as ``[x, y, z]`` in degrees. This is
        the bend direction hint used by IK solvers.
        """
    def set_preferred_angle(self, angle: list[float]=...) -> None:
        """
        Sets the preferred angle from ``[x, y, z]`` in degrees. If no angle
        is given, the joint's current rotation is stored as its preferred
        angle (equivalent to "Set Preferred Angle" in the Maya UI).
        """
    def segment_scale_compensate(self) -> bool:
        """
        Returns True if segment scale compensate is enabled — i.e. this
        joint does not inherit the scale of its parent joint.
        """
    def set_segment_scale_compensate(self, state: bool) -> None:
        """
        Enables or disables segment scale compensate on this joint.
        """
    def radius(self) -> float:
        """
        Returns the display radius of the joint.
        """
    def set_radius(self, radius: float) -> None:
        """
        Sets the display radius of the joint.
        """
    def parent_joint(self) -> mref.ReferencedItem | None:
        """
        Returns the parent of this joint if (and only if) that parent is
        itself a joint, otherwise None. Use ``parent()`` for the plain
        DAG parent.
        """
    def child_joints(self, recursive: bool=...) -> mref.ReferenceList:
        """
        Returns the joints parented directly under this joint. If
        ``recursive`` is True, every descendant joint is returned instead
        (depth-first, parents before children).
        """
    def chain_to(self, end_joint: mref.ReferencedItem | str) -> mref.ReferenceList:
        """
        Returns the joint chain from this joint down to ``end_joint``,
        inclusive of both ends, ordered root to tip. Raises ``ValueError``
        if ``end_joint`` is not this joint or one of its descendant joints
        (connected through joints only).
        """
    def orient_to_child(self, child: mref.ReferencedItem | str=..., aim_axis: str=..., up_axis: str=..., world_up: list[float]=...) -> None:
        """
        Orients this joint so that ``aim_axis`` points at ``child`` (the
        first child joint if not given) and ``up_axis`` points as closely
        as possible toward the ``world_up`` vector.

        Axes are given as ``"x"``, ``"y"``, ``"z"``, optionally prefixed
        with ``"-"`` (e.g. ``aim_axis="-x"`` for mirrored chains). The new
        orientation is stored entirely in ``jointOrient`` — ``rotate`` and
        ``rotateAxis`` are zeroed — and all children stay where they are
        in world space.
        """
    def orient_to_world(self) -> None:
        """
        Orients this joint so its local axes align with the world axes,
        storing the result in ``jointOrient`` (``rotate`` and ``rotateAxis``
        are zeroed). Children stay where they are in world space. This is
        the typical treatment for end joints.
        """
    def freeze_rotation(self) -> None:
        """
        Bakes the current ``rotate`` and ``rotateAxis`` values into
        ``jointOrient`` and zeroes them, without changing the joint's
        orientation or moving any children. Equivalent to freezing
        rotation on a single joint.
        """

class LatticeTrait:
    """
    Trait bound to any node with ``MFn.kFFD`` — the free-form (``ffd``)
    lattice deformer. Exposes the driving lattice and base lattice
    shapes, the lattice divisions, local mode and local influence, and
    the outside-lattice behaviour.

    Input/output geometry, the envelope and the paintable per-component
    weights are provided by the generic ``GeometryFilter`` trait which is
    also bound to every ffd.
    """
    def lattice(self) -> mref.ReferencedItem | None:
        """
        Returns the lattice shape (``MFn.kLattice``) driving this ffd, or
        None if it is not connected. Use ``.transform()`` on the result
        to get the lattice transform.
        """
    def base_lattice(self) -> mref.ReferencedItem | None:
        """
        Returns the base lattice shape (``MFn.kBaseLattice``) which
        defines the rest position of the lattice, or None if it is not
        connected.
        """
    def divisions(self) -> tuple[int, int, int]:
        """
        Returns the (s, t, u) divisions of the lattice driving this ffd
        """
    def set_divisions(self, s: int, t: int, u: int) -> None:
        """
        Sets the (s, t, u) divisions of the lattice driving this ffd.
        This resets the lattice points to a regular grid.
        """
    def is_local(self) -> bool:
        """
        Returns True if the ffd is in local mode — each lattice point
        only influences the geometry near it (see
        :meth:`local_influence`).
        """
    def set_local(self, state: bool) -> None:
        """
        Sets whether the ffd is in local mode
        """
    def local_influence(self) -> tuple[int, int, int]:
        """
        Returns the (s, t, u) local influence — the number of lattice
        points in each direction that affect a deformed point when the
        ffd is in local mode.
        """
    def set_local_influence(self, s: int, t: int, u: int) -> None:
        """
        Sets the (s, t, u) local influence used when the ffd is in local
        mode
        """
    def outside_lattice(self) -> str:
        """
        Returns how points outside the lattice are deformed, one of
        ``"inside"`` (only points inside are deformed), ``"all"`` (every
        point is deformed) or ``"falloff"`` (points within
        :meth:`outside_falloff_distance` are deformed).
        """
    def set_outside_lattice(self, mode: str, falloff_distance: float=...) -> None:
        """
        Sets how points outside the lattice are deformed — ``mode`` is
        one of ``"inside"``, ``"all"`` or ``"falloff"``. If given,
        ``falloff_distance`` also sets the falloff distance used by the
        ``"falloff"`` mode.
        """
    def outside_falloff_distance(self) -> float:
        """
        Returns the distance outside the lattice within which points are
        still deformed when the outside-lattice mode is ``"falloff"``
        """

class LatticeShapeTrait:
    """
    Trait bound to any node with ``MFn.kLattice`` — the lattice shape
    which drives an ffd deformer (but not the base lattice, which is
    ``MFn.kBaseLattice``). Exposes the divisions, bulk and single point
    position get/set, the ffd deformers it drives, and the
    skinnable-shape protocol (``component_count``/``component_path``)
    so other deformers on the lattice (clusters, skins) can read and
    write per-point weights.

    Point positions use the flat point index Maya uses for the lattice
    geometry: ``s + t * S + u * S * T`` for divisions ``(S, T, U)`` —
    see :meth:`point_index`. API 2.0 has no ``MFnLattice``, so positions
    are read and written through ``MItGeometry``, which supports the
    ``"object"`` and ``"world"`` spaces.
    """
    def divisions(self) -> tuple[int, int, int]:
        """
        Returns the (s, t, u) divisions of the lattice
        """
    def set_divisions(self, s: int, t: int, u: int) -> None:
        """
        Sets the (s, t, u) divisions of the lattice. If the lattice
        drives an ffd the edit goes through ``cmds.lattice`` so the
        deformer is updated correctly; this resets the lattice points to
        a regular grid.
        """
    def point_count(self) -> int:
        """
        Returns the number of lattice points (``S * T * U``)
        """
    def point_index(self, s: int, t: int, u: int) -> int:
        """
        Returns the flat point index of the lattice point ``pt[s][t][u]``
        as used by the point position methods.
        """
    def point_positions(self, space: str=...) -> list[list[float]]:
        """
        Returns the positions of every lattice point as a list of
        ``[x, y, z]`` lists, ordered by flat point index.
        """
    def set_point_positions(self, positions: list[list[float]], space: str=...) -> None:
        """
        Sets the position of every lattice point from a list of
        ``[x, y, z]`` lists ordered by flat point index. ``positions``
        must have exactly ``point_count()`` entries.
        """
    def point_position(self, index: int, space: str=...) -> list[float]:
        """
        Returns the ``[x, y, z]`` position of the lattice point with the
        given flat index (see :meth:`point_index`).
        """
    def set_point_position(self, index: int, position: list[float], space: str=...) -> None:
        """
        Sets the ``[x, y, z]`` position of the lattice point with the
        given flat index (see :meth:`point_index`).
        """
    def ffd_deformers(self) -> mref.ReferenceList:
        """
        Returns the ffd deformers this lattice drives
        """
    def component_count(self) -> int:
        """
        Returns the number of lattice points.

        Part of the skinnable-shape protocol consumed by
        ``GeometryFilter``/``SkinCluster``.
        """
    def component_path(self, component_index: int) -> str:
        """
        Returns the fully qualified path to the lattice point with the
        given flat index — ``<full_path>.pt[s][t][u]``.

        Part of the skinnable-shape protocol consumed by
        ``GeometryFilter``/``SkinCluster``.
        """

class LightTrait:
    """
    Trait bound to light shape nodes. Native Maya lights (ambient,
    directional, point, spot, area and volume) are matched via
    ``MFn.kLight``. Arnold (mtoa) lights such as ``aiAreaLight`` and
    ``aiSkyDomeLight`` do *not* derive from ``kLight``, so shape nodes
    whose type classification contains the ``light`` token are also
    bound (the classification lookup is cached per node type).

    Exposes colour, intensity, a light type label, shadow casting and
    light-linking (which objects this light illuminates).

    Note: :meth:`intensity` shadows property-style access to the Maya
    ``intensity`` attribute (``light.intensity``); use
    ``light.attribute("intensity")`` to get the plug.
    """
    def colour(self) -> list[float]:
        """
        Returns the ``[r, g, b]`` colour of the light
        """
    def set_colour(self, colour: list[float]) -> None:
        """
        Sets the ``[r, g, b]`` colour of the light
        """
    def intensity(self) -> float:
        """
        Returns the intensity of the light
        """
    def set_intensity(self, value: float) -> None:
        """
        Sets the intensity of the light
        """
    def light_type(self) -> str:
        """
        Returns a renderer-agnostic label for the kind of light, derived
        from the node type with any ``ai`` prefix and ``Light`` suffix
        removed — for instance ``"spot"``, ``"point"``, ``"directional"``,
        ``"area"`` (for both ``areaLight`` and ``aiAreaLight``) or
        ``"skyDome"``.
        """
    def casts_shadows(self) -> bool:
        """
        Returns True if this light casts shadows. For native Maya lights
        this is True if either raytraced or depth map shadows are on;
        for plugin (Arnold) lights the ``aiCastShadows`` attribute is used.
        """
    def set_casts_shadows(self, state: bool) -> None:
        """
        Turns shadow casting on or off. For native Maya lights, turning
        shadows on enables raytraced shadows and turning them off
        disables both raytraced and depth map shadows. For plugin
        (Arnold) lights ``aiCastShadows`` is set.
        """
    def illuminated_objects(self) -> mref.ReferenceList:
        """
        Returns the DAG objects this light illuminates according to
        Maya's light linking. Shading engines and other sets that the
        light-link query also reports are excluded.
        """
    def link_objects(self, objects: 'list|mref.ReferencedItem|str') -> None:
        """
        Makes a light link between this light and the given object(s),
        so the light illuminates them.
        """
    def unlink_objects(self, objects: 'list|mref.ReferencedItem|str') -> None:
        """
        Breaks the light link between this light and the given object(s),
        so the light no longer illuminates them.
        """

class LocatorTrait:
    """
    Trait bound to any node with ``MFn.kLocator`` — locator shape nodes
    (``spaceLocator`` and other locator-derived shapes). Exposes the
    shape-level local position and scale offsets, plus the evaluated
    world position of the locator.
    """
    def local_position(self) -> list[float]:
        """
        Returns the locator's shape-level position offset (``localPosition``)
        as ``[x, y, z]``, relative to its transform.
        """
    def set_local_position(self, position: list[float]) -> None:
        """
        Sets the locator's shape-level position offset (``localPosition``)
        from ``[x, y, z]``.
        """
    def local_scale(self) -> list[float]:
        """
        Returns the locator's shape-level display scale (``localScale``)
        as ``[x, y, z]``.
        """
    def set_local_scale(self, scale: list[float]) -> None:
        """
        Sets the locator's shape-level display scale (``localScale``)
        from ``[x, y, z]``. A single float may be given for a uniform scale.
        """
    def world_position(self) -> list[float]:
        """
        Returns the evaluated world space position of the locator as
        ``[x, y, z]`` — the transform's world position combined with the
        shape's ``localPosition`` offset.
        """

class MatrixNodeTrait:
    """
    Trait bound to Maya's matrix utility nodes — ``multMatrix``,
    ``addMatrix``, ``wtAddMatrix``, ``decomposeMatrix``,
    ``composeMatrix``, ``pickMatrix``, ``blendMatrix``, ``aimMatrix``,
    ``parentMatrix``, ``holdMatrix``, ``passMatrix``,
    ``fourByFourMatrix``, ``uvPin`` and ``proximityPin`` (via their
    ``MFn`` constants), plus the plugin-supplied ``inverseMatrix`` and
    ``transposeMatrix`` (by type name, as they only report
    ``kPluginDependNode``).

    Exposes a uniform view over the differing attribute layouts of
    these nodes: the output matrix value and plug, the ordered matrix
    input plugs and their sources, appending inputs, TRS decomposition
    of the output, and wiring the result onto a transform.

    Matrices are flat lists of 16 floats in the same layout as
    ``Transform.get_matrix`` (translation in elements 12-14).
    """
    def output_matrix_attribute(self, index: int=...) -> mref.ReferencedItem | None:
        """
        Returns the output matrix attribute of this node, or None if the
        node has no matrix output (``decomposeMatrix``). ``index`` selects
        the element for nodes with array outputs (``uvPin``,
        ``proximityPin``) and is ignored otherwise.
        """
    def output_matrix(self, index: int=...) -> list[float] | None:
        """
        Returns the evaluated output matrix of this node as a flat list
        of 16 floats, or None if the node has no matrix output
        (``decomposeMatrix``). ``index`` selects the element for nodes
        with array outputs.
        """
    def input_matrix_attributes(self) -> mref.ReferenceList:
        """
        Returns the matrix input attributes of this node in evaluation
        order — for example ``matrixIn[0..n]`` on a ``multMatrix``, or
        ``inputMatrix`` followed by each ``target[n].targetMatrix`` on a
        ``blendMatrix``. Array inputs contribute their existing elements
        only.
        """
    def matrix_sources(self) -> mref.ReferenceList:
        """
        Returns the attributes feeding this node's matrix inputs, in
        input order. Unconnected inputs are skipped. Each entry is an
        attribute ReferencedItem (use ``.node()`` for the driving node).
        """
    def add_matrix_input(self, source: 'mref.ReferencedItem|str|list[float]') -> mref.ReferencedItem:
        """
        Feeds a matrix into the next free input slot and returns the
        input attribute used. Fixed inputs (``inputMatrix``,
        ``primaryTargetMatrix``, ...) are filled first if unconnected;
        after that a new element is appended to the node's array input
        (``matrixIn``, ``target``, ``wtMatrix``).

        ``source`` may be an attribute (connected directly), a node
        (its ``worldMatrix[0]`` is connected) or a flat list of 16
        floats (set as a static value). New ``wtAddMatrix`` elements
        get a weight of ``1.0``.
        """
    def output_translation(self, index: int=...) -> list[float]:
        """
        Returns the translation ``[x, y, z]`` of the node's output. For a
        ``decomposeMatrix`` this is its ``outputTranslate``; for other
        nodes the output matrix is decomposed.
        """
    def output_rotation(self, index: int=...) -> list[float]:
        """
        Returns the rotation ``[x, y, z]`` in degrees of the node's output.
        For a ``decomposeMatrix`` this is its ``outputRotate`` (which
        honours ``inputRotateOrder``); for other nodes the output matrix
        is decomposed using the xyz rotate order.
        """
    def output_scale(self, index: int=...) -> list[float]:
        """
        Returns the scale ``[x, y, z]`` of the node's output. For a
        ``decomposeMatrix`` this is its ``outputScale``; for other nodes
        the output matrix is decomposed.
        """
    def connect_output_to(self, transform: 'mref.ReferencedItem|str', offset_parent_matrix: bool=..., index: int=...) -> mref.ReferencedItem:
        """
        Drives the given transform with this node's result and returns
        the node that ends up wired to the transform.

        - A ``decomposeMatrix`` connects its translate / rotate / scale /
          shear outputs directly to the transform's channels.
        - Otherwise, by default, the output matrix is connected to the
          transform's ``offsetParentMatrix`` (the transform's own TRS
          then acts as a local offset on top).
        - With ``offset_parent_matrix=False`` a new ``decomposeMatrix`` is
          created between this node and the transform, its rotate order
          driven by the transform's ``rotateOrder``; the new node is
          returned. Note joint orients are not compensated for.
        """

class MayaObjectTrait:
    def m_object(self) -> om.MObject:
        """
        Returns the mobject for this object
        """
    def api_type(self) -> str:
        """
        Returns the OpenMaya function set type of this object as a string,
        for example ``"kTransform"`` or ``"kMesh"``.
        """

class MeshTrait:
    """
    Trait bound to any node with ``MFn.kMesh`` — polygon mesh shape
    nodes. Provides vertex position queries (single and bulk),
    polygon and edge counts, normals, UV sets and UVs, topology
    queries (face / edge / connected / border vertices), closest point
    and ray intersection queries, shading engine discovery, skin
    cluster discovery, and the skinnable-shape protocol used by
    ``SkinCluster`` to read and write weights.

    Unlike ``Transform``, this trait supports the full set of Maya
    transformation spaces (``"object"``, ``"world"``, ``"local"``,
    ``"pretransform"``, ``"posttransform"``, ``"last"``) via the
    underlying ``MFnMesh`` API — see :meth:`vertex_positions` and the
    other space-aware methods. The function set is built from a DAG
    path on every call, so world space queries work and the trait
    stays valid if the shape is re-parented. Binding never touches the
    mesh data, so an empty mesh node (``cmds.createNode("mesh")``) can
    still be wrapped.
    """
    def vertex_count(self) -> int:
        """
        Returns the total count of vertices making up the mesh
        """
    def polygon_count(self) -> int:
        """
        Returns the total count of polygons making up the mesh
        """
    def edge_count(self) -> int:
        """
        Returns the total count of edges making up the mesh
        """
    def vertex_positions(self, space: str=...) -> list[list[float]]:
        """
        This returns a list containing a list of three components correlating to
        the x, y, z positions of the vertices.
        """
    def set_vertex_positions(self, positions: list[list[float]], space: str=...):
        """
        This takes in a positions list, in the format:

        [
            [x, y, z],
            [x, y, z],
            [x, y, z],
            [x, y, z],
            ...
        ]

        Where each triplet list defines the position of the vertex id in the
        list order. ``positions`` must have exactly ``vertex_count()``
        entries — anything else raises ``ValueError``.
        """
    def vertex_position(self, vertex_id: int, space: str=...) -> list[float]:
        """
        This returns a list containing the three components correlating to
        the x, y, z positions of the vertex.
        """
    def set_vertex_position(self, vertex_id: int, position: list[float], space=...):
        """
        This takes in a position list, in the format:

            [x, y, z]

        The vertex with the given id will then have its position set to those values.
        """
    def vertex_normals(self, space: str=..., angle_weighted: bool=...) -> list[list[float]]:
        """
        Returns one ``[x, y, z]`` normal per vertex, in vertex index
        order. Each is the average of the vertex's face-vertex normals,
        optionally weighted by the face angle at the vertex. Uses a
        single bulk ``MFnMesh.getVertexNormals`` call.
        """
    def face_normals(self, space: str=...) -> list[list[float]]:
        """
        Returns one ``[x, y, z]`` normal per polygon, in face index
        order.
        """
    def face_vertices(self, face_id: int | None=...) -> list[int] | list[list[int]]:
        """
        Returns the vertex indices making up the face with the given id,
        in winding order. If ``face_id`` is None the vertex lists for
        every face are returned (a list of lists, in face index order),
        read in a single bulk ``MFnMesh.getVertices`` call.
        """
    def edge_vertices(self, edge_id: int) -> tuple[int, int]:
        """
        Returns the two vertex indices at either end of the edge with
        the given id.
        """
    def connected_vertices(self, vertex_id: int) -> list[int]:
        """
        Returns the indices of every vertex sharing an edge with the
        given vertex.
        """
    def border_vertices(self) -> list[int]:
        """
        Returns the sorted indices of every vertex lying on an open
        (boundary) edge of the mesh. A closed mesh returns an empty
        list.
        """
    def uv_set_names(self) -> list[str]:
        """
        Returns the names of all the UV sets on the mesh
        """
    def current_uv_set(self) -> str:
        """
        Returns the name of the mesh's current (working) UV set
        """
    def set_current_uv_set(self, uv_set: str) -> None:
        """
        Makes the given UV set the mesh's current (working) UV set.
        Raises ``ValueError`` if no UV set with that name exists.
        """
    def uv_count(self, uv_set: str | None=...) -> int:
        """
        Returns the number of UVs in the given UV set, or in the current
        UV set if none is given.
        """
    def uvs(self, uv_set: str | None=...) -> list[list[float]]:
        """
        Returns one ``[u, v]`` pair per UV in the given UV set (or the
        current UV set if none is given), in UV index order.
        """
    def set_uvs(self, uvs: list[list[float]], uv_set: str | None=...) -> None:
        """
        Sets every UV in the given UV set (or the current UV set if none
        is given) from a list of ``[u, v]`` pairs in UV index order, as
        returned by :meth:`uvs`. Only the UV values change — face
        assignments are left untouched, so ``uvs`` must have exactly
        ``uv_count(uv_set)`` entries or ``ValueError`` is raised.
        """
    def uv_at_point(self, position: list[float], space: str=..., uv_set: str | None=...) -> tuple[float, float, int]:
        """
        Returns the UV of the point on the mesh closest to ``position``
        as a tuple of ``(u, v, face_id)``. Useful for placing follicles
        or pinning objects to a surface.
        """
    def closest_point(self, position: list[float], space: str=...) -> tuple[list[float], list[float], int]:
        """
        Returns the point on the mesh closest to ``position`` as a tuple
        of ``([x, y, z], [nx, ny, nz], face_id)`` — the closest position,
        the surface normal at that position and the id of the face it
        lies on. Both the input and the results are expressed in
        ``space``.
        """
    def ray_intersection(self, source: list[float], direction: list[float], space: str=..., max_distance: float=..., both_directions: bool=...) -> tuple[list[float], int] | None:
        """
        Casts a ray from ``source`` along ``direction`` and returns the
        nearest hit on the mesh as a tuple of ``([x, y, z], face_id)``,
        or None if the ray misses. ``source``, ``direction`` and the
        hit point are all expressed in ``space`` (world by default).
        Hits further than ``max_distance`` are ignored, and
        ``both_directions`` also tests the ray backwards from source.
        """
    def shading_engines(self) -> mref.ReferenceList:
        """
        Returns the shading engines (shading groups) assigned to this
        mesh — whole-object and per-face assignments alike — for the
        first instance of the shape.
        """
    def skin(self) -> mref.ReferencedItem | None:
        """
        Returns a ReferencedItem for the SkinCluster bound to this
        mesh, or None if no skin cluster is connected.
        """
    def component_count(self) -> int:
        """
        Returns the number of vertices in the mesh.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`: ``component_count()`` is the number of
        weights that need to be supplied per influence.
        """
    def component_path(self, component_index: int) -> str:
        """
        Returns the fully qualified path to the component with the
        given index — for meshes, this is ``<full_path>.vtx[N]``.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`.
        """
    def face_component_path(self, face_id: int) -> str:
        """
        Returns the fully qualified path to the face with the given id,
        in the form ``<full_path>.f[N]``.
        """
    def edge_component_path(self, edge_id: int) -> str:
        """
        Returns the fully qualified path to the edge with the given id,
        in the form ``<full_path>.e[N]``.
        """

class NonLinearTrait:
    """
    Trait bound to any node with ``MFn.kNonLinear`` — the ``nonLinear``
    deformer node created by ``cmds.nonLinear`` (bend, twist, flare,
    sine, squash and wave). Exposes the handle transform and handle
    shape, the deformer type, and its type-specific parameters
    (curvature, start/end angle, low/high bound, amplitude, ...).

    The parameters are stored on the nonLinear node and drive the
    matching attributes on the handle shape, so they are read and
    written here rather than on the handle.

    Input/output geometry, the envelope and the paintable per-component
    weights are provided by the generic ``GeometryFilter`` trait which is
    also bound to every nonLinear deformer.
    """
    def handle(self) -> mref.ReferencedItem | None:
        """
        Returns the handle transform which positions the deformer (the
        node whose ``worldMatrix`` feeds the deformer's ``matrix``), or
        None if it is not connected.
        """
    def handle_shape(self) -> mref.ReferencedItem | None:
        """
        Returns the handle shape (``deformBend``, ``deformTwist``, ...)
        which draws the deformer, or None if there is none.
        """
    def deformer_type(self) -> str:
        """
        Returns the type of nonLinear deformer — one of ``"bend"``,
        ``"twist"``, ``"flare"``, ``"sine"``, ``"squash"`` or
        ``"wave"``.
        """
    def parameters(self) -> dict:
        """
        Returns a dict of the type-specific parameters of this deformer
        and their values, e.g. ``{"curvature": 0.0, "lowBound": -1.0,
        "highBound": 1.0}`` for a bend.
        """
    def parameter(self, name: str) -> float | bool:
        """
        Returns the value of the named type-specific parameter (see
        :meth:`parameters` for the valid names)
        """
    def set_parameter(self, name: str, value: float | bool) -> None:
        """
        Sets the value of the named type-specific parameter (see
        :meth:`parameters` for the valid names)
        """
    def bounds(self) -> tuple[float, float]:
        """
        Returns the (low, high) bounds of the deformation along the
        handle's axis. Not available on wave deformers, which are
        radial (see ``minRadius``/``maxRadius``).
        """
    def set_bounds(self, low: float, high: float) -> None:
        """
        Sets the (low, high) bounds of the deformation along the
        handle's axis. Not available on wave deformers.
        """
    def curvature(self) -> float:
        """
        Returns the curvature of a bend deformer, in degrees
        """
    def set_curvature(self, value: float) -> None:
        """
        Sets the curvature of a bend deformer, in degrees
        """
    def angles(self) -> tuple[float, float]:
        """
        Returns the (start, end) angles of a twist deformer, in degrees
        """
    def set_angles(self, start: float, end: float) -> None:
        """
        Sets the (start, end) angles of a twist deformer, in degrees
        """

class NucleusTrait:
    """
    Trait bound to any node with ``MFn.kNucleus`` — the Nucleus
    dynamics solver (a transform-derived node). Exposes the active and
    passive objects it solves, adding objects to it, gravity magnitude
    and direction, the simulation start frame, and enabling / disabling
    the solver.

    Note: the ``enable()`` method shadows the solver's ``enable``
    Maya attribute for property-style access; use
    ``item.attribute("enable")`` for the plug itself.
    """
    def active_objects(self) -> mref.ReferenceList:
        """
        Returns the active objects (nCloth, nParticle, hair systems...)
        connected to this solver's ``inputActive`` array, in index order.
        """
    def passive_objects(self) -> mref.ReferenceList:
        """
        Returns the passive colliders (nRigid) connected to this
        solver's ``inputPassive`` array, in index order.
        """
    def objects(self) -> mref.ReferenceList:
        """
        Returns every object solved by this nucleus — active objects
        followed by passive ones.
        """
    def add_object(self, nucleus_object: 'mref.ReferencedItem|str') -> None:
        """
        Connects the given Nucleus object (nCloth, nRigid, nParticle,
        hair system) to this solver, moving it off any solver it is
        currently connected to. Delegates to the object's
        ``set_solver`` method.
        """
    def gravity(self) -> float:
        """
        Returns the gravity magnitude of this solver
        """
    def set_gravity(self, value: float) -> None:
        """
        Sets the gravity magnitude of this solver
        """
    def gravity_direction(self) -> list[float]:
        """
        Returns the gravity direction of this solver as ``[x, y, z]``
        """
    def set_gravity_direction(self, direction: list[float]) -> None:
        """
        Sets the gravity direction of this solver from ``[x, y, z]``
        """
    def start_frame(self) -> float:
        """
        Returns the frame at which this solver's simulation starts
        """
    def set_start_frame(self, frame: float) -> None:
        """
        Sets the frame at which this solver's simulation starts
        """
    def is_enabled(self) -> bool:
        """
        Returns True if this solver is enabled
        """
    def enable(self) -> None:
        """
        Enables this solver
        """
    def disable(self) -> None:
        """
        Disables this solver, freezing every object it solves
        """

class NucleusObjectTrait:
    """
    Trait bound to any Nucleus-simulated shape — nodes with
    ``MFn.kNBase`` (``nCloth``, ``nRigid``, ``nParticle``) and hair
    systems (``MFn.kHairSystem``, which is not ``kNBase``-derived but is
    solved by nucleus in the same way). Exposes the nucleus solver the
    object belongs to (and moving it to another solver), whether it is a
    passive collider, enabling / disabling simulation, the input and
    output meshes of cloth and rigid objects, and the follicles feeding
    a hair system.
    """
    def solver(self) -> mref.ReferencedItem | None:
        """
        Returns the nucleus solver node this object is connected to, or
        None if it is not connected to one.
        """
    def is_passive(self) -> bool:
        """
        Returns True if this object is connected to its solver as a
        passive collider (``inputPassive``) — typically an ``nRigid``.
        """
    def set_solver(self, nucleus: 'mref.ReferencedItem|str') -> None:
        """
        Connects this object to the given nucleus solver, disconnecting
        it from its current solver first. Passive objects (``nRigid``)
        are connected to the solver's passive inputs; everything else is
        connected as an active object, including the solver's
        ``outputObjects`` feeding back into ``nextState``.
        """
    def is_enabled(self) -> bool:
        """
        Returns True if this object is being simulated. For nBase
        objects this is ``isDynamic``; for hair systems it is a
        ``simulationMethod`` other than Off.
        """
    def enable(self) -> None:
        """
        Enables simulation of this object. For hair systems this sets
        ``simulationMethod`` to All Follicles (3) if it is currently Off;
        any other non-off method is left untouched.
        """
    def disable(self) -> None:
        """
        Disables simulation of this object (``isDynamic`` off, or
        ``simulationMethod`` Off for hair systems).
        """
    def input_mesh(self) -> mref.ReferencedItem | None:
        """
        Returns the mesh shape feeding this object's ``inputMesh`` (the
        source geometry of an ``nCloth`` or ``nRigid``), or None if there
        is none or the object type has no mesh input.
        """
    def output_mesh(self) -> mref.ReferencedItem | None:
        """
        Returns the mesh shape driven by this object's ``outputMesh``
        (the simulated result of an ``nCloth``), or None if there is none
        or the object type has no mesh output.
        """
    def hair_follicles(self) -> mref.ReferenceList:
        """
        Returns the follicle shapes feeding this hair system's
        ``inputHair`` array, in index order. Empty for non-hair objects.
        """

class NurbsCurveTrait:
    """
    Trait bound to any node with ``MFn.kNurbsCurve`` — nurbs curve
    shape nodes. Provides CV position queries (single and bulk),
    counts of CVs / knots / spans, degree, form, knots, length and
    parameter range, point / tangent / normal at parameter, parameter
    at length, closest point queries, reversing, skin cluster
    discovery, and the skinnable-shape protocol used by
    ``SkinCluster`` to read and write weights.

    Unlike ``Transform``, this trait supports the full set of Maya
    transformation spaces (``"object"``, ``"world"``, ``"local"``,
    ``"pretransform"``, ``"posttransform"``, ``"last"``) via the
    underlying ``MFnNurbsCurve`` API — see :meth:`cv_positions` and
    the other space-aware methods. The function set is built from a
    DAG path on every call, so world space queries work and the trait
    stays valid if the shape is re-parented. Binding never touches the
    curve data, so an empty curve node (``cmds.createNode("nurbsCurve")``)
    can still be wrapped.
    """
    def skin(self) -> mref.ReferencedItem | None:
        """
        Returns a ReferencedItem for the SkinCluster bound to this
        curve, or None if no skin cluster is connected.
        """
    def cv_count(self) -> int:
        """
        Returns the total count of cv's making up the curve
        """
    def knot_count(self) -> int:
        """
        Returns the total count of knots making up the curve
        """
    def span_count(self) -> int:
        """
        Returns the total count of spans making up the curve
        """
    def degree(self) -> int:
        """
        Returns the degree of the curve (1 = linear, 3 = cubic, ...)
        """
    def form(self) -> str:
        """
        Returns the form of the curve as one of ``"open"``, ``"closed"``
        or ``"periodic"``.
        """
    def knots(self) -> list[float]:
        """
        Returns the knot vector of the curve
        """
    def parameter_range(self) -> tuple[float, float]:
        """
        Returns the ``(min, max)`` parameter range of the curve
        """
    def length(self) -> float:
        """
        Returns the arc length of the curve in object space units
        """
    def component_count(self) -> int:
        """
        Returns the number of CVs in the curve.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`: ``component_count()`` is the number of
        weights that need to be supplied per influence.
        """
    def component_path(self, component_index: int) -> str:
        """
        Returns the fully qualified path to the component with the
        given index — for curves, this is ``<full_path>.cv[N]``.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`.
        """
    def cv_positions(self, space: str=...) -> list[list[float]]:
        """
        Returns a list of ``[x, y, z]`` positions, one per CV, in CV
        index order. Uses ``MFnNurbsCurve.cvPositions`` for a single
        bulk API call instead of iterating per-CV.
        """
    def set_cv_positions(self, positions: list[list[float]], space: str=...):
        """
        This takes in a positions list, in the format:

        [
            [x, y, z],
            [x, y, z],
            [x, y, z],
            [x, y, z],
            ...
        ]

        Where each triplet list defines the position of the CV id in the
        list order. Applies the entire array in one
        ``MFnNurbsCurve.setCVPositions`` call.
        """
    def cv_position(self, cv_index: int, space: str=...) -> list[float]:
        """
        This returns a list containing the three components correlating to
        the x, y, z positions of the cv.
        """
    def set_cv_position(self, cv_index: int, position: list[float], space: str=...):
        """
        This takes in a position list, in the format:

            [x, y, z]

        The vertex with the given id will then have its position set to those values.
        """
    def point_at_parameter(self, parameter: float, space: str=...) -> list[float]:
        """
        Returns the ``[x, y, z]`` position on the curve at the given
        parameter.
        """
    def tangent_at_parameter(self, parameter: float, space: str=...) -> list[float]:
        """
        Returns the normalised ``[x, y, z]`` tangent of the curve at the
        given parameter.
        """
    def normal_at_parameter(self, parameter: float, space: str=...) -> list[float]:
        """
        Returns the normalised ``[x, y, z]`` normal of the curve at the
        given parameter. Straight (linear) sections of a curve have no
        meaningful curvature normal; Maya returns a perpendicular vector
        there.
        """
    def parameter_at_length(self, length: float) -> float:
        """
        Returns the parameter at the given arc length along the curve,
        measured from its start. ``length`` is clamped to the curve's
        total :meth:`length`.
        """
    def parameter_at_point(self, position: list[float], space: str=...) -> float:
        """
        Returns the curve parameter at the point on the curve closest to
        ``position``. Unlike ``MFnNurbsCurve.getParamAtPoint`` the
        position does not need to lie exactly on the curve.
        """
    def closest_point(self, position: list[float], space: str=...) -> tuple[list[float], float]:
        """
        Returns the point on the curve closest to ``position`` as a
        tuple of ``([x, y, z], parameter)``. Both the input and the
        result are expressed in ``space``.
        """
    def reverse(self) -> None:
        """
        Reverses the direction of the curve in place, so the last CV
        becomes the first. Done directly on the shape's data via
        ``MFnNurbsCurve.reverse``, so no history node is added.
        """

class NurbsSurfaceTrait:
    """
    Trait bound to any node with ``MFn.kNurbsSurface`` — nurbs surface
    shape nodes. Provides CV counts / spans / degrees in U and V, CV
    position queries (single and bulk), parameter ranges, closest point
    and point-at-parameter queries, skin cluster discovery, and the
    skinnable-shape protocol used by ``SkinCluster`` to read and write
    weights.

    CVs are addressed as ``(u, v)`` pairs. Bulk lists are ordered with
    ``u`` as the outer loop and ``v`` as the inner loop (flat index
    ``u * cv_count_v() + v``) — the same ordering ``SkinCluster`` uses.

    Supports the full set of Maya transformation spaces (``"object"``,
    ``"world"``, ``"local"``, ``"pretransform"``, ``"posttransform"``,
    ``"last"``). The function set is built from a DAG path so world
    space queries work.
    """
    def cv_count_u(self) -> int:
        """
        Returns the number of CVs in the U direction
        """
    def cv_count_v(self) -> int:
        """
        Returns the number of CVs in the V direction
        """
    def cv_count(self) -> int:
        """
        Returns the total number of CVs making up the surface (U * V)
        """
    def span_count_u(self) -> int:
        """
        Returns the number of spans in the U direction
        """
    def span_count_v(self) -> int:
        """
        Returns the number of spans in the V direction
        """
    def degree_u(self) -> int:
        """
        Returns the degree of the surface in the U direction
        """
    def degree_v(self) -> int:
        """
        Returns the degree of the surface in the V direction
        """
    def parameter_range_u(self) -> tuple[float, float]:
        """
        Returns the ``(min, max)`` parameter range of the surface in U
        """
    def parameter_range_v(self) -> tuple[float, float]:
        """
        Returns the ``(min, max)`` parameter range of the surface in V
        """
    def cv_positions(self, space: str=...) -> list[list[float]]:
        """
        Returns a list of ``[x, y, z]`` positions, one per CV, ordered
        with ``u`` as the outer loop and ``v`` as the inner loop. Uses
        ``MFnNurbsSurface.cvPositions`` for a single bulk API call.
        """
    def set_cv_positions(self, positions: list[list[float]], space: str=...):
        """
        Sets every CV position from a list of ``[x, y, z]`` triplets in
        the same ``u``-outer / ``v``-inner order :meth:`cv_positions`
        returns. ``positions`` must have exactly ``cv_count()`` entries —
        anything else raises ``ValueError``.
        """
    def cv_position(self, u: int, v: int, space: str=...) -> list[float]:
        """
        Returns the ``[x, y, z]`` position of the CV at index ``(u, v)``.
        """
    def set_cv_position(self, u: int, v: int, position: list[float], space: str=...):
        """
        Sets the position of the CV at index ``(u, v)`` from ``[x, y, z]``.
        """
    def point_at_parameter(self, u: float, v: float, space: str=...) -> list[float]:
        """
        Returns the ``[x, y, z]`` position on the surface at the given
        ``(u, v)`` parameter.
        """
    def closest_point(self, position: list[float], space: str=...) -> tuple[list[float], float, float]:
        """
        Returns the point on the surface closest to ``position`` as a
        tuple of ``([x, y, z], u, v)`` — the closest position and the
        surface parameters at that position. Both the input and the
        result are expressed in ``space``.
        """
    def skin(self) -> mref.ReferencedItem | None:
        """
        Returns a ReferencedItem for the SkinCluster bound to this
        surface, or None if no skin cluster is connected.
        """
    def component_count(self) -> int:
        """
        Returns the number of CVs in the surface.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`: ``component_count()`` is the number of
        weights that need to be supplied per influence.
        """
    def component_path(self, component_index: int) -> str:
        """
        Returns the fully qualified path to the component with the
        given flat index — for surfaces, this is ``<full_path>.cv[u][v]``
        where ``u = index // cv_count_v()`` and ``v = index % cv_count_v()``,
        matching the ordering ``SkinCluster`` uses.

        Part of the skinnable-shape protocol consumed by
        :class:`SkinCluster`.
        """

class ObjectSetTrait:
    """
    Trait bound to any node with ``MFn.kSet`` — object sets, shading
    engines, deformer sets and any other set-derived node. Exposes
    membership queries and edits.

    Members which are components (``pCube1.vtx[0:3]``) cannot be cast
    to a ReferencedItem, so they are returned as plain strings within
    the ``ReferenceList``.
    """
    def members(self, flatten: bool=...) -> mref.ReferenceList:
        """
        Returns the members of this set. If ``flatten`` is True then
        component ranges are expanded into individual components.
        """
    def add_members(self, members: list | mref.ReferencedItem | str) -> None:
        """
        Adds the given node(s) or component(s) to this set
        """
    def remove_members(self, members: list | mref.ReferencedItem | str) -> None:
        """
        Removes the given node(s) or component(s) from this set
        """
    def is_member(self, member: mref.ReferencedItem | str) -> bool:
        """
        Returns True if the given node or component is in this set
        """
    def clear(self) -> None:
        """
        Removes every member from this set
        """

class ReferenceTrait:
    """
    Trait bound to any node with ``MFn.kReference`` — the reference
    node (``fooRN``) Maya creates for every file reference. Exposes the
    referenced file path, namespace, load state, the nodes the reference
    brings in, nested (parent / child) references and the load, unload,
    reload, replace and remove operations.

    The bookkeeping reference nodes ``sharedReferenceNode`` and
    ``_UNKNOWN_REF_NODE_`` are deliberately not bound, as they are not
    backed by a file and every reference query on them fails.
    """
    def file_path(self, copy_number: bool=..., resolved: bool=...) -> str:
        """
        Returns the path of the file this reference points to. When the
        same file is referenced more than once Maya suffixes the path
        with a copy number (``scene.ma{1}``); pass ``copy_number=True``
        to keep that suffix. Pass ``resolved=False`` to get the path as
        written in the scene (which may contain environment variables)
        rather than the resolved path.
        """
    def namespace(self, short: bool=...) -> str:
        """
        Returns the namespace the referenced nodes live in, without a
        leading colon (``char:rig`` for a nested reference). Pass
        ``short=True`` to get only the final namespace (``rig``).
        """
    def is_loaded(self) -> bool:
        """
        Returns True if the referenced file is currently loaded
        """
    def load(self) -> None:
        """
        Loads the referenced file. Does nothing if it is already loaded.
        """
    def unload(self) -> None:
        """
        Unloads the referenced file. Does nothing if it is already
        unloaded.
        """
    def reload(self) -> None:
        """
        Reloads the referenced file from disk, picking up any changes
        saved since it was loaded. Loads it if it is currently unloaded.
        """
    def replace_file(self, file_path: str) -> None:
        """
        Swaps the file this reference points to for the given file,
        keeping the reference node, namespace and any reference edits
        which still apply.
        """
    def contained_nodes(self) -> mref.ReferenceList:
        """
        Returns the nodes brought into the scene by this reference. Nodes
        belonging to nested references are reported by those nested
        reference nodes, not this one. Unloaded references contain no
        nodes.
        """
    def parent_reference(self) -> mref.ReferencedItem | None:
        """
        Returns the reference node this reference is nested within, or
        None if it is a top-level reference.
        """
    def child_references(self) -> mref.ReferenceList:
        """
        Returns the reference nodes directly nested within this
        reference's file.
        """
    def remove(self) -> None:
        """
        Removes this reference from the scene entirely, along with all
        the nodes it brought in and its reference node.
        """

class ScriptNodeTrait:
    """
    Trait bound to any node with ``MFn.kScript`` — script nodes created
    by ``cmds.scriptNode``. Exposes the before / after scripts, when the
    scripts run (the script type), which language they are written in
    (the source type), and lets them be executed on demand.

    Script types are reported as one of the names in ``SCRIPT_TYPES``
    (``"demand"``, ``"open_close"``, ``"gui_open_close"``,
    ``"ui_configuration"``, ``"software_render"``,
    ``"software_frame_render"``, ``"scene_configuration"``,
    ``"time_changed"``) and source types as ``"mel"`` or ``"python"``.
    Setters accept either the name or Maya's integer index.
    """
    def before_script(self) -> str:
        """
        Returns the "before" script — run on scene open, render start or
        time change depending on the script type, or by
        :meth:`execute_before`.
        """
    def set_before_script(self, script: str) -> None:
        """
        Sets the "before" script
        """
    def after_script(self) -> str:
        """
        Returns the "after" script — run on scene close or render end
        depending on the script type, or by :meth:`execute_after`.
        """
    def set_after_script(self, script: str) -> None:
        """
        Sets the "after" script
        """
    def script_type(self) -> str:
        """
        Returns when this script node's scripts are run, as one of the
        names in ``SCRIPT_TYPES``.
        """
    def set_script_type(self, script_type: str | int) -> None:
        """
        Sets when this script node's scripts are run. Accepts a name from
        ``SCRIPT_TYPES`` or Maya's integer index.
        """
    def source_type(self) -> str:
        """
        Returns the language the scripts are written in, ``"mel"`` or
        ``"python"``.
        """
    def set_source_type(self, source_type: str | int) -> None:
        """
        Sets the language the scripts are written in. Accepts ``"mel"``,
        ``"python"`` or Maya's integer index.
        """
    def execute_before(self) -> None:
        """
        Runs the "before" script now
        """
    def execute_after(self) -> None:
        """
        Runs the "after" script now
        """

class ShaderTrait:
    """
    Trait bound to surface shader nodes — any node type whose
    classification contains ``shader/surface`` (lambert, blinn, phong,
    standardSurface, openPBRSurface, surfaceShader, aiStandardSurface,
    aiFlat, ...). There is no common ``MFn`` constant for surface
    shaders across native and plugin types, so binding uses
    ``cmds.getClassification`` cached per node type name.

    Exposes the shading groups the shader feeds, geometry assignment
    (creating a shading group when needed) and a generic colour accessor.
    """
    def shading_groups(self) -> mref.ReferenceList:
        """
        Returns the shading groups whose ``surfaceShader`` slot this
        shader is connected to.
        """
    def create_shading_group(self) -> mref.ReferencedItem:
        """
        Returns the first shading group this shader feeds, creating and
        connecting a new one (named ``<shader>SG``) if there is none.
        """
    def assign_to(self, geometry: 'list|mref.ReferencedItem|str') -> None:
        """
        Assigns this shader to the given geometry — transforms, shapes
        or face components (``"pCube1.f[0:3]"``). A shading group is
        created if the shader does not have one yet.
        """
    def assigned_geometry(self) -> mref.ReferenceList:
        """
        Returns the unique shape nodes which have this shader assigned
        (to the whole object or to some faces) via any of its shading
        groups.
        """
    def colour_attribute(self) -> mref.ReferencedItem | None:
        """
        Returns the attribute holding this shader's main colour —
        ``baseColor`` (standardSurface, openPBRSurface,
        aiStandardSurface), ``color`` (lambert family, aiFlat) or a
        writable ``outColor`` (surfaceShader). Returns None if the
        shader type has none of these.
        """
    def colour(self) -> list[float] | None:
        """
        Returns the ``[r, g, b]`` main colour of this shader (see
        :meth:`colour_attribute`), or None if it has no recognised
        colour attribute.
        """
    def set_colour(self, colour: list[float]) -> None:
        """
        Sets the ``[r, g, b]`` main colour of this shader (see
        :meth:`colour_attribute`). Raises RuntimeError if the shader has
        no recognised colour attribute.
        """

class ShadingEngineTrait:
    """
    Trait bound to any node with ``MFn.kShadingEngine`` — shading groups.
    Stacks on top of the generic ``ObjectSet`` trait (a shading engine is
    an object set), so membership edits use ``members`` /
    ``add_members`` / ``remove_members`` from there; assigning geometry
    to a shading group is ``add_members``. This trait adds the shader
    slots (surface, displacement, volume) and geometry-level assignment
    queries.
    """
    def surface_shader(self) -> mref.ReferencedItem | None:
        """
        Returns the shader connected to this shading group's
        ``surfaceShader`` slot, or None if nothing is connected.
        """
    def set_surface_shader(self, shader: 'mref.ReferencedItem|str|None') -> None:
        """
        Connects the given shader's ``outColor`` into this shading
        group's ``surfaceShader`` slot. Passing None disconnects the slot.
        """
    def displacement_shader(self) -> mref.ReferencedItem | None:
        """
        Returns the node connected to this shading group's
        ``displacementShader`` slot, or None if nothing is connected.
        """
    def set_displacement_shader(self, shader: 'mref.ReferencedItem|str|None') -> None:
        """
        Connects the given displacement node's ``displacement`` output
        into this shading group's ``displacementShader`` slot. Passing
        None disconnects the slot.
        """
    def volume_shader(self) -> mref.ReferencedItem | None:
        """
        Returns the shader connected to this shading group's
        ``volumeShader`` slot, or None if nothing is connected.
        """
    def set_volume_shader(self, shader: 'mref.ReferencedItem|str|None') -> None:
        """
        Connects the given shader's ``outColor`` into this shading
        group's ``volumeShader`` slot. Passing None disconnects the slot.
        """
    def assigned_geometry(self) -> mref.ReferenceList:
        """
        Returns the unique shape nodes which have this shading group
        assigned, either to the whole object or to some of its faces.
        Unlike ``members`` this never returns component strings.
        """
    def assigned_components(self) -> list[str]:
        """
        Returns only the per-face (component) assignments of this shading
        group, as long-named component strings such as
        ``"|pCube1|pCubeShape1.f[0:2]"``. Whole-object assignments are
        not included.
        """

class ShapeTrait:
    """
    Trait bound to any node with ``MFn.kShape`` — meshes, curves,
    surfaces, locators, cameras, lights, lattices and every other shape
    type. Exposes the owning transform, the intermediate-object flag,
    bounding boxes and the deformer stack feeding the shape.

    Priority ``0``. Shape-specific traits (``Mesh``, ``NurbsCurve``,
    ``Camera``, ...) sit at priority ``1`` so they win if they ever
    define a method with the same name.
    """
    def transform(self) -> mref.ReferencedItem | None:
        """
        Returns the transform which owns this shape, or None if the
        shape has no parent (which Maya does not normally allow).
        """
    def is_intermediate(self) -> bool:
        """
        Returns True if this shape is flagged as an intermediate object
        (typically the original, pre-deformation shape of a deformed mesh).
        """
    def set_intermediate(self, state: bool) -> None:
        """
        Sets whether this shape is flagged as an intermediate object
        """
    def bounding_box(self, space: str=...) -> list[list[float]]:
        """
        Returns the bounding box of the shape as ``[[min_x, min_y, min_z],
        [max_x, max_y, max_z]]``. ``space`` may be ``"object"`` or
        ``"world"``.
        """
    def deformers(self, node_type: str=...) -> mref.ReferenceList:
        """
        Returns the deformers in this shape's history, nearest first.
        ``node_type`` can be used to narrow the result to a specific
        deformer type (for instance ``"skinCluster"``).
        """

class SkinClusterTrait:
    """
    Trait bound to any node with ``MFn.kSkinClusterFilter``. Provides
    influence enumeration, fast bulk weight read/write via the OpenMaya
    MFnSkinCluster API, influence management, and access to the shapes
    being driven. Also exposes single-influence / single-component
    weights, weight maintenance (max influences, pruning, normalisation),
    the skinning method, and the bind pose.
    """
    def influences(self) -> list[mref.ReferencedItem]:
        """
        Returns a list of influences on the skin cluster, in the same
        order ``MFnSkinCluster`` reports them.
        """
    def weights(self) -> dict:
        """
        Reads every skin weight in a single API call and returns a
        JSON-serialisable dict of the shape::

            {
                "influences":     [name, ...],
                "weights":        [[float, ...], ...],   # per-influence lists
                "max_influences": int,
            }

        ``weights[i]`` is the per-component weight list for
        ``influences[i]``.
        """
    def set_weights(self, weight_data: dict, normalize: bool=...) -> None:
        """
        Applies skin weights from a dict of the shape returned by
        ``weights()``, in a single ``MFnSkinCluster.setWeights`` call.

        Any influences named in ``weight_data["influences"]`` that are
        not yet on this skin cluster are auto-added via ``add_influence``
        before the weights are applied.

        :param weight_data: Dict with ``"influences"`` (list of names)
            and ``"weights"`` (list of per-influence weight lists).
        :param normalize: If True (default), Maya normalises the applied
            weights per component.
        """
    def add_influence(self, influence: mref.ReferencedItem | str, **kwargs) -> None:
        """
        Adds the given influence to this skin cluster.
        """
    def shape(self) -> mref.ReferencedItem | None:
        """
        Returns the first shape driven by this skin cluster, or None if
        the cluster currently drives no geometry.
        """
    def shapes(self) -> list[mref.ReferencedItem]:
        """
        Returns a list of all shapes driven by this skin cluster.
        """
    def remove_influence(self, influence: mref.ReferencedItem | str) -> None:
        """
        Removes the given influence from this skin cluster. Maya
        redistributes (normalises) the removed influence's weight across
        the remaining influences.
        """
    def unused_influences(self) -> mref.ReferenceList:
        """
        Returns the influences which carry no weight on any component
        of the skinned shape. Read with a single bulk ``getWeights`` call.
        """
    def remove_unused_influences(self) -> mref.ReferenceList:
        """
        Removes every influence which carries no weight (see
        :meth:`unused_influences`) and returns the removed influences.
        """
    def influence_weights(self, influence: mref.ReferencedItem | str) -> list[float]:
        """
        Returns the per-component weights of a single influence on the
        skinned shape, in component order.
        """
    def set_influence_weights(self, influence: mref.ReferencedItem | str, weights: list[float], normalize: bool=...) -> None:
        """
        Sets the per-component weights of a single influence in one
        ``MFnSkinCluster.setWeights`` call. ``weights`` must have exactly
        one entry per component.

        :param normalize: If True (default), the other influences on each
            component are scaled so the component still sums to 1.
        """
    def component_weights(self, index: int) -> dict:
        """
        Returns the weights of a single component (vertex / CV) as a dict
        of ``{influence_name: weight}``. Only influences with a non-zero
        weight are included. For NURBS surfaces ``index`` is the flattened
        ``u * numCVsInV + v`` index used by ``weights()``.
        """
    def set_component_weights(self, index: int, weights: dict, normalize: bool=...) -> None:
        """
        Sets the weights of a single component (vertex / CV) from a dict
        of ``{influence: weight}``, as returned by
        :meth:`component_weights`. Influences not named in the dict are
        set to zero on that component, so the dict fully describes it.

        :param normalize: If True (default), the given weights are
            normalised to sum to 1.
        """
    def copy_weights_to(self, skin_cluster: mref.ReferencedItem | str, surface_association: str=..., influence_association: tuple=...) -> None:
        """
        Copies this skin's weights onto another skin cluster using
        ``copySkinWeights``. Any of this skin's influences missing from
        the destination are added to it first, as ``copySkinWeights``
        only transfers onto influences already present.
        """
    def max_influences(self) -> int:
        """
        Returns the maximum number of influences allowed per component.
        """
    def set_max_influences(self, value: int, maintain: bool=...) -> None:
        """
        Sets the maximum number of influences per component, and whether
        Maya should enforce it while weights are edited
        (``maintainMaxInfluences``). Existing weights that already exceed
        the limit are not altered.
        """
    def prune_weights(self, threshold: float=...) -> None:
        """
        Zeroes every weight below ``threshold`` on the skinned shape and
        renormalises the remaining weights (``skinPercent -pruneWeights``).
        """
    def normalize_weights(self) -> None:
        """
        Forces every component's weights to sum to 1, regardless of the
        current normalisation mode.
        """
    def normalization_mode(self) -> str:
        """
        Returns the weight normalisation mode: ``"none"``,
        ``"interactive"`` or ``"post"``.
        """
    def set_normalization_mode(self, mode: str | int) -> None:
        """
        Sets the weight normalisation mode from ``"none"``,
        ``"interactive"``, ``"post"`` or the equivalent enum index.
        """
    def skinning_method(self) -> str:
        """
        Returns the skinning method: ``"linear"``, ``"dual_quaternion"``
        or ``"blended"`` (weight blended).
        """
    def set_skinning_method(self, method: str | int) -> None:
        """
        Sets the skinning method from ``"linear"``, ``"dual_quaternion"``,
        ``"blended"`` or the equivalent enum index.
        """
    def bind_pose(self) -> mref.ReferencedItem | None:
        """
        Returns the dagPose node storing this skin's bind pose, or None
        if it has none.
        """
    def go_to_bind_pose(self) -> None:
        """
        Restores the influences to this skin's bind pose.

        :raises RuntimeError: If the skin cluster has no bind pose.
        """
    def unbind(self) -> None:
        """
        Unbinds the skin, deleting this skin cluster and leaving the
        geometry in its undeformed state. This ReferencedItem is no
        longer valid afterwards.
        """

class SpotLightTrait:
    """
    Trait bound to any node with ``MFn.kSpotLight`` — Maya spot lights.
    Stacks on top of :class:`Light` to expose the spot-specific cone
    angle, penumbra angle and dropoff. Angles are in degrees.
    """
    def cone_angle(self) -> float:
        """
        Returns the cone angle of the spot light in degrees
        """
    def set_cone_angle(self, degrees: float) -> None:
        """
        Sets the cone angle of the spot light in degrees
        """
    def penumbra_angle(self) -> float:
        """
        Returns the penumbra angle of the spot light in degrees
        """
    def set_penumbra_angle(self, degrees: float) -> None:
        """
        Sets the penumbra angle of the spot light in degrees
        """
    def dropoff(self) -> float:
        """
        Returns the dropoff (falloff from centre to edge) of the spot light
        """
    def set_dropoff(self, value: float) -> None:
        """
        Sets the dropoff (falloff from centre to edge) of the spot light
        """

class TransformTrait:
    """
    Trait bound to any node with ``MFn.kTransform`` — transforms,
    joints, cluster handles, follicles, and anything else with a
    transformation. Sits above ``DagNode`` and ``DependencyNode`` in
    the resolution chain.

    Provides matrix get/set, translation/rotation/scale convenience
    accessors, an ``xform`` passthrough that auto-injects this node's
    full DAG path, and a ``match_to`` helper for snapping one transform
    to another.

    Space handling: methods that take a ``space`` argument accept either
    ``"object"`` (the node's local transform space) or ``"world"`` (the
    scene root coordinate system). Other Maya transformation spaces
    (``kPreTransform``, ``kPostTransform``, etc.) are not supported by
    ``cmds.xform`` and would require a different API path.
    """
    def get_matrix(self, space: str=...) -> list[float]:
        """
        Returns this transform's matrix as a flat 4x4 list of 16 floats
        in column-major order.

        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def set_matrix(self, matrix: list[float], space: str=...) -> None:
        """
        Sets this transform's matrix from a flat 4x4 list of 16 floats
        in column-major order.

        :param matrix: Flat 4x4 matrix as 16 floats, column-major.
        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def get_position(self, space: str=...) -> list[float]:
        """
        Returns the translation as ``[x, y, z]``.

        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def set_position(self, position: list[float], space: str=...) -> None:
        """
        Sets the translation from ``[x, y, z]``.

        :param position: Translation values as ``[x, y, z]``.
        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def get_rotation(self, space: str=...) -> list[float]:
        """
        Returns the rotation as ``[x, y, z]`` Euler angles in degrees.

        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def set_rotation(self, rotation: list[float], space: str=...) -> None:
        """
        Sets the rotation from ``[x, y, z]`` Euler angles in degrees.

        :param rotation: Euler angles in degrees as ``[x, y, z]``.
        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def get_scale(self, space: str=...) -> list[float]:
        """
        Returns the scale as ``[x, y, z]``.

        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def set_scale(self, scale: list[float], space: str=...) -> None:
        """
        Sets the scale from ``[x, y, z]``.

        :param scale: Scale factors as ``[x, y, z]``.
        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def xform(self, **kwargs) -> typing.Any:
        """
        Calls ``cmds.xform`` against this transform, auto-injecting its
        full DAG path as the first positional argument. The return type
        depends on the kwargs — ``query=True`` calls return a list of
        floats; mutating calls return ``None``.
        """
    def match_to(self, other: mref.ReferencedItem | str, space: str=...) -> None:
        """
        Match this transform to another. By default the match is in
        worldspace, which snaps this node to the same position /
        orientation / scale as ``other`` regardless of either node's
        parent hierarchy. Pass ``space="object"`` for an object-space
        copy of ``other``'s matrix (useful when both nodes share the
        same parent).
        """
    def get_offset_parent_matrix(self) -> list[float]:
        """
        Returns the ``offsetParentMatrix`` as a flat list of 16 floats.
        This matrix sits between the parent and the local transform, so
        it can hold a rest pose while translate/rotate/scale stay zeroed.
        """
    def set_offset_parent_matrix(self, matrix: list[float]) -> None:
        """
        Sets the ``offsetParentMatrix`` from a flat list of 16 floats.
        """
    def get_pivot(self, space: str=...) -> list[float]:
        """
        Returns the rotate pivot position as ``[x, y, z]``.

        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def set_pivot(self, position: list[float], space: str=...) -> None:
        """
        Moves both the rotate and scale pivots to the given position,
        as pressing D / Insert and moving the pivot does. The node does
        not move.

        :param position: Pivot position as ``[x, y, z]``.
        :param space: Either ``"object"`` (default) or ``"world"``.
        """
    def get_rotate_order(self) -> str:
        """
        Returns the rotate order as a lower-case string, e.g. ``"xyz"``.
        """
    def set_rotate_order(self, rotate_order: str, preserve: bool=...) -> None:
        """
        Sets the rotate order from a string such as ``"zxy"``.

        :param preserve: If True (default), the rotate values are changed
            so the node keeps its current orientation. If False, only the
            order changes and the node visibly rotates.
        """
    def get_limits(self, channel: str) -> list[float | None]:
        """
        Returns the ``[minimum, maximum]`` transform limits of a single
        channel, with None for a side that is not enabled.

        :param channel: A channel name such as ``"tx"``, ``"rotateY"``
            or ``"scaleZ"``. Rotation limits are in degrees.
        """
    def set_limits(self, channel: str, minimum: float | None=..., maximum: float | None=...) -> None:
        """
        Sets the transform limits of a single channel. A side given as
        None is disabled, so ``set_limits("ty")`` removes both limits.

        :param channel: A channel name such as ``"tx"``, ``"rotateY"``
            or ``"scaleZ"``. Rotation limits are in degrees.
        """
    def freeze_transforms(self, translate: bool=..., rotate: bool=..., scale: bool=...) -> None:
        """
        Freezes the transforms (``makeIdentity -apply``) — bakes the
        current translate / rotate / scale into the node's children and
        geometry so the channels read zero (one for scale) without
        anything moving. On joints a frozen rotation moves into
        ``jointOrient``.
        """
    def reset_transforms(self, translate: bool=..., rotate: bool=..., scale: bool=...) -> None:
        """
        Resets translate and rotate to zero and scale to one
        (``makeIdentity`` without ``-apply``). Unlike
        ``freeze_transforms`` this moves the node back to its parent's
        origin.
        """
    def axis_vector(self, axis: str=..., space: str=...) -> list[float]:
        """
        Returns the normalised direction one of this node's local axes
        points in, as ``[x, y, z]``.

        :param axis: ``"x"``, ``"y"`` or ``"z"``, optionally prefixed
            with ``"-"`` for the negative direction.
        :param space: ``"world"`` (default) for the direction in world
            space, or ``"object"`` for the direction in the parent's space.
        """
    def aim_at(self, target: 'mref.ReferencedItem|str|list[float]', aim_vector: list[float]=..., up_vector: list[float]=..., world_up_vector: list[float]=..., world_up_object: 'mref.ReferencedItem|str|None'=...) -> None:
        """
        Rotates this node so its ``aim_vector`` axis points at the
        target. This is a one-off snap (a temporary aim constraint is
        created and removed), not a live constraint.

        :param target: A node, or a world-space position ``[x, y, z]``.
        :param aim_vector: The local axis to point at the target.
        :param up_vector: The local axis to align with the world up.
        :param world_up_vector: The world-space up direction, used when
            no ``world_up_object`` is given.
        :param world_up_object: If given, the up axis aims at this
            node's position instead of following ``world_up_vector``.
        """

class WireTrait:
    """
    Trait bound to any node with ``MFn.kWire`` — the wire deformer.
    Exposes the influence wire curves and their base wires, adding
    wires, the per-wire dropoff distance and scale, and the deformer
    wide rotation, tension, crossing effect and local influence.

    Per-wire methods take ``wire`` as either the wire's index (its
    logical index in ``deformedWire[]``) or the wire curve itself
    (transform or shape).

    Input/output geometry, the envelope and the paintable per-component
    weights are provided by the generic ``GeometryFilter`` trait which is
    also bound to every wire deformer.
    """
    def wires(self) -> mref.ReferenceList:
        """
        Returns the curve shapes acting as influence wires, ordered by
        wire index
        """
    def base_wires(self) -> mref.ReferenceList:
        """
        Returns the base wire curve shapes (the rest position of each
        influence wire), ordered by wire index
        """
    def add_wire(self, curve: mref.ReferencedItem | str) -> None:
        """
        Adds the given curve as an additional influence wire. Maya
        creates a matching base wire for it.
        """
    def dropoff_distance(self, wire: int | mref.ReferencedItem | str=...) -> float:
        """
        Returns the dropoff distance of the given wire — how far from
        the wire the deformation reaches
        """
    def set_dropoff_distance(self, value: float, wire: int | mref.ReferencedItem | str=...) -> None:
        """
        Sets the dropoff distance of the given wire, or of every wire
        when ``wire`` is None
        """
    def wire_scale(self, wire: int | mref.ReferencedItem | str=...) -> float:
        """
        Returns the scale of the given wire — how much scaling the wire
        curve scales the deformed geometry
        """
    def set_wire_scale(self, value: float, wire: int | mref.ReferencedItem | str=...) -> None:
        """
        Sets the scale of the given wire, or of every wire when ``wire``
        is None
        """
    def wire_rotation(self) -> float:
        """
        Returns how much of the wires' twisting is applied to the
        deformed geometry, in the range 0 to 1
        """
    def set_wire_rotation(self, value: float) -> None:
        """
        Sets how much of the wires' twisting is applied to the deformed
        geometry, in the range 0 to 1
        """
    def tension(self) -> float:
        """
        Returns the tension of the wires where multiple wires meet
        """
    def set_tension(self, value: float) -> None:
        """
        Sets the tension of the wires where multiple wires meet
        """
    def crossing_effect(self) -> float:
        """
        Returns the crossing effect — how deformations combine where
        wires cross (0 adds them, 1 averages them)
        """
    def set_crossing_effect(self, value: float) -> None:
        """
        Sets the crossing effect — how deformations combine where wires
        cross (0 adds them, 1 averages them)
        """
    def local_influence(self) -> float:
        """
        Returns the local influence — how much wires' deformations are
        localised where they cross
        """
    def set_local_influence(self, value: float) -> None:
        """
        Sets the local influence — how much wires' deformations are
        localised where they cross
